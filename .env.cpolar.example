# ============================================================
# MyCollegeNew cpolar 公网隧道部署环境变量模板
# 复制为 .env.cpolar 后填入实际值，不要提交到版本库
#
# 部署架构：
#   公网用户 → HTTPS → cpolar 隧道 → 内网服务器:8080 → Docker 容器
# ============================================================

# ---- 必须项 ----

# JWT 密钥：至少 32 字符随机字符串，可通过以下命令生成：
#   openssl rand -base64 32
JWT_SECRET_KEY=

# cpolar 分配的公网域名（不含协议前缀，如 abc-8080.example.cpolar.cn）
CPOLAR_DOMAIN=

# CORS 允许的前端域名（通常为 https://<CPOLAR_DOMAIN>）
CORS_ALLOWED_ORIGINS=

# MySQL root 密码（由数据库容器初始化使用）
MYSQL_ROOT_PASSWORD=

# MySQL 专用应用用户密码（应用程序使用此用户连接数据库，权限最小）
MYSQL_DATABASE_PASSWORD=

# ---- 数据库连接字符串 ----
# 使用专用应用用户而非 root，格式：Server=db;Port=3306;Database=attendance;Uid=app_user;Pwd=PASSWORD;
DB_CONNECTION_STRING=Server=db;Port=3306;Database=attendance;Uid=app_user;Pwd=YOUR_PASSWORD;

# ---- 可选项 ----

# 日志级别（可选：Debug / Information / Warning / Error）
LOGGING__LOGLEVEL__DEFAULT=Information

# JWT 过期时间（分钟）
JWT_EXPIRE_MINUTES=120