{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API 服务",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/src/MyCollegeNew.Api/bin/Debug/net10.0/MyCollegeNew.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/MyCollegeNew.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5144"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/src/MyCollegeNew.Api/Views"
      }
    },
    {
      "name": "Web 前端",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-web",
      "program": "${workspaceFolder}/src/MyCollegeNew.Web/bin/Debug/net10.0/MyCollegeNew.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/MyCollegeNew.Web",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5249"
      }
    },
    {
      "name": "单元测试",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-tests",
      "program": "${workspaceFolder}/src/MyCollegeNew.Tests/bin/Debug/net10.0/MyCollegeNew.Tests.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/MyCollegeNew.Tests",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}