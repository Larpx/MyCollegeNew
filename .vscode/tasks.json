{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/src/Campus.Attendance.sln"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build-api",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/src/Campus.Attendance.Api/Campus.Attendance.Api.csproj", "--no-incremental"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-web",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/src/Campus.Attendance.Web/Campus.Attendance.Web.csproj", "--no-incremental"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-tests",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/src/Campus.Attendance.Tests/Campus.Attendance.Tests.csproj", "--no-incremental"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/src/Campus.Attendance.Tests/Campus.Attendance.Tests.csproj", "--logger", "console;verbosity=detailed"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "clean",
      "command": "dotnet",
      "type": "process",
      "args": ["clean", "${workspaceFolder}/src/Campus.Attendance.sln"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "restore",
      "command": "dotnet",
      "type": "process",
      "args": ["restore", "${workspaceFolder}/src/Campus.Attendance.sln"],
      "problemMatcher": "$msCompile"
    }
  ]
}