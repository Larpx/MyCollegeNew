<?xml version="1.0"?>
<!--
  有关如何配置 ASP.NET 应用程序的详细信息，请访问
  http://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.0"/>
    <pages enableEventValidation="false"/>
  </system.web>
  <appSettings>
    <!--数据库连接字符串-->
    <add key="connstr" value="Data Source=(local);Initial Catalog=System_DataBase;Integrated Security=True"/>
  </appSettings>
</configuration>