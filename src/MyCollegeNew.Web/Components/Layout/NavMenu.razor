@* 侧边栏导航：根据角色与系主任标记位动态显示菜单项（Admin 已移至独立项目） *@
@inject IApiClient ApiClient
@inject TokenService TokenService
@inject ILogger<NavMenu> Logger
@using Larpx.PersonalTools.MyCollegeNew.Shared.Features.Users

<nav class="nav-menu">
    <div class="nav-menu__brand">
        <Icon Name="graduation-cap" Size="22" />
        <span class="nav-menu__brand-text">考勤管理系统</span>
    </div>

    <AuthorizeView>
        <Authorized>
            <ul class="nav-menu__list">
                @foreach (var item in GetMenuItems(context.User))
                {
                    <li class="nav-menu__item">
                        <NavLink class="nav-menu__link" href="@item.Href" Match="@NavLinkMatch.Prefix"
                                 ActiveClass="nav-menu__link--active">
                            <Icon Name="@item.Icon" Size="20" />
                            <span>@item.Title</span>
                        </NavLink>
                    </li>
                }
            </ul>
        </Authorized>
    </AuthorizeView>
</nav>

@code {
    /// <summary>菜单项定义</summary>
    private sealed record MenuItem(string Title, string Href, string Icon);

    /// <summary>当前教师是否为系主任（用于动态渲染系主任专属菜单）</summary>
    private bool _isDepartmentHead;

    /// <summary>
    /// 初始化：若当前用户为教师/辅导员，调用 GET /api/v1/teachers/me 查询 IsDepartmentHead 标记位，
    /// 查询失败不影响基础菜单展示，仅系主任专属菜单不渲染
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // 学生角色不查系主任身份，直接跳过
        var userInfo = TokenService.GetUserInfo();
        if (userInfo is null || userInfo.Role == "Student")
        {
            return;
        }

        try
        {
            var teacher = await ApiClient.GetAsync<TeacherResponseDto>("teachers/me");
            _isDepartmentHead = teacher?.IsDepartmentHead ?? false;
        }
        catch (Exception ex)
        {
            // 加载失败时静默降级：仅不展示系主任专属菜单，避免阻塞侧边栏渲染
            Logger.LogWarning(ex, "加载当前教师身份信息失败，系主任专属菜单暂不可用");
        }
    }

    /// <summary>
    /// 根据当前用户角色与系主任标记位返回菜单项（Admin 已移至独立项目）
    /// </summary>
    private List<MenuItem> GetMenuItems(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole("Teacher") || user.IsInRole("Counselor"))
        {
            var items = new List<MenuItem>
            {
                new("仪表盘", "/teacher/dashboard", "layout-dashboard"),
                new("我的课程", "/teacher/courses", "book-open"),
                new("我的课表", "/teacher/schedule", "calendar"),
                new("考勤记录", "/teacher/attendance", "clipboard-list"),
                new("调换课申请", "/teacher/swaps", "shuffle")
            };

            // 系主任专属菜单：排课工作台 + 接课审批 + 本系统计报表
            if (_isDepartmentHead)
            {
                items.Add(new("排课工作台", "/teacher/scheduling", "calendar-days"));
                items.Add(new("接课审批", "/teacher/assignments/review", "inbox"));
                items.Add(new("本系统计报表", "/teacher/department/reports", "bar-chart-3"));
            }

            if (user.IsInRole("Counselor"))
            {
                items.Add(new("请假审批", "/teacher/leaves", "file-text"));
            }
            return items;
        }

        if (user.IsInRole("Student"))
        {
            return new List<MenuItem>
            {
                new("首页", "/student/home", "home"),
                new("快捷签到", "/student/checkin", "qr-code"),
                new("我的考勤", "/student/attendance", "clipboard-list"),
                new("请假申请", "/student/leaves", "file-text"),
                new("我的课表", "/student/schedule", "calendar"),
                new("个人信息", "/student/profile", "user")
            };
        }

        return new List<MenuItem>();
    }
}
