@* 角色访问守卫：基于 AuthorizeView 角色过滤，未授权显示访问拒绝提示 *@
<AuthorizeView Roles="@Roles">
    <Authorized>
        @ChildContent
    </Authorized>
    <NotAuthorized>
        <div class="access-guard">
            <div class="access-guard__icon">
                <Icon Name="lock" Size="32" />
            </div>
            <h2 class="access-guard__title">无访问权限</h2>
            <p class="access-guard__description">
                您当前的角色无权访问此页面，请联系管理员。
            </p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    /// <summary>允许访问的角色列表（逗号分隔，如 "Admin" 或 "Teacher,Counselor"）</summary>
    [Parameter]
    [EditorRequired]
    public string Roles { get; set; } = string.Empty;

    /// <summary>子内容（受保护的内容）</summary>
    [Parameter]
    [EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;
}
