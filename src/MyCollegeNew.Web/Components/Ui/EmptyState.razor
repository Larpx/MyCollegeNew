@* 空状态提示组件 *@
<div class="ui-empty-state @Class">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <div class="ui-empty-state__icon">
            <Icon Name="@Icon" Size="32" />
        </div>
    }
    <h3 class="ui-empty-state__title">@Title</h3>
    @if (!string.IsNullOrEmpty(Description))
    {
        <p class="ui-empty-state__description">@Description</p>
    }
    @if (Actions is not null)
    {
        <div class="ui-empty-state__actions">
            @Actions
        </div>
    }
</div>

@code {
    /// <summary>标题</summary>
    [Parameter]
    [EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>描述文本</summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>图标名称（默认 info）</summary>
    [Parameter]
    public string Icon { get; set; } = "info";

    /// <summary>操作区</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>自定义 CSS 类</summary>
    [Parameter]
    public string? Class { get; set; }
}
