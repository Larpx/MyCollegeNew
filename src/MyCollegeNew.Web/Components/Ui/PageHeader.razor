@* 页面标题组件：标题 + 可选操作按钮区 *@
<div class="ui-page-header @Class">
    <div class="ui-page-header__main">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="ui-page-header__icon">
                <Icon Name="@Icon" Size="20" />
            </span>
        }
        <div class="ui-page-header__text">
            <h1 class="ui-page-header__title">@Title</h1>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="ui-page-header__subtitle">@Subtitle</p>
            }
        </div>
    </div>
    @if (Actions is not null)
    {
        <div class="ui-page-header__actions">
            @Actions
        </div>
    }
</div>

@code {
    /// <summary>页面标题</summary>
    [Parameter]
    [EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>副标题</summary>
    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>图标名称</summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>操作区（按钮等）</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>自定义 CSS 类</summary>
    [Parameter]
    public string? Class { get; set; }
}
