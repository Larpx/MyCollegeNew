@page "/login"
@layout LoginLayout
@rendermode InteractiveServer

<PageTitle>@_pageTitle - 考勤管理系统</PageTitle>

<div class="login-page">
    @* 左侧品牌展示区 *@
    <div class="login-page__brand">
        <div class="login-page__deco login-page__deco--1"></div>
        <div class="login-page__deco login-page__deco--2"></div>
        <div class="login-page__deco login-page__deco--3"></div>

        <div class="login-page__brand-content">
            <div class="login-page__brand-icon">
                <Icon Name="graduation-cap" Size="40" />
            </div>
            <h1 class="login-page__brand-title">考勤管理系统</h1>
            <p class="login-page__brand-subtitle">@_brandSubtitle</p>
            <p class="login-page__brand-quote">让每一次考勤都有迹可循</p>
        </div>
    </div>

    @* 右侧登录表单区 *@
    <div class="login-page__form-side">
        <div class="login-form">
            <div class="login-form__header">
                <h2 class="login-form__title">@_formTitle</h2>
                <p class="login-form__subtitle">登录你的账号以继续</p>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert--error" role="alert">
                    <Icon Name="alert-circle" Size="18" />
                    <span>@_errorMessage</span>
                </div>
            }

            @* 传统 form POST：由 Program.cs 的 /auth/login 端点处理登录与 2FA 流程 *@
            <form method="post" action="/auth/login" class="login-form__form">
                <AntiforgeryToken />
                <div class="ui-input-wrapper">
                    <span class="ui-input-icon">
                        <Icon Name="user" Size="18" />
                    </span>
                    <input id="username" name="Username" class="ui-input"
                           placeholder="学号 / 工号" required autocomplete="username" />
                </div>

                <div class="ui-input-wrapper">
                    <span class="ui-input-icon">
                        <Icon Name="lock" Size="18" />
                    </span>
                    <input id="password" name="Password" type="password" class="ui-input"
                           placeholder="密码" required autocomplete="current-password" />
                </div>

                @* 滑块验证码：Blazor Server 交互，验证通过后启用登录按钮 *@
                <div class="login-form__captcha">
                    <SliderCaptcha OnVerified="OnCaptchaVerified" @ref="_captchaRef" />
                </div>

                <button type="submit" class="login-form__submit"
                        disabled="@string.IsNullOrEmpty(_captchaToken)">
                    <span>登录</span>
                </button>
            </form>
        </div>
    </div>
</div>

@code {
    /// <summary>角色查询参数：teacher / student</summary>
    [SupplyParameterFromQuery(Name = "role")]
    public string? Role { get; set; }

    /// <summary>从查询参数获取错误消息</summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorMessage { get; set; }

    /// <summary>滑块验证码组件引用</summary>
    private SliderCaptcha? _captchaRef;

    /// <summary>滑块验证码 token</summary>
    private string _captchaToken = string.Empty;

    /// <summary>错误消息</summary>
    private string? _errorMessage;

    /// <summary>根据角色参数动态生成页面标题</summary>
    private string _pageTitle => Role switch
    {
        "teacher" => "教师登录",
        "student" => "学生登录",
        _ => "登录"
    };

    /// <summary>根据角色参数动态生成品牌区副标题</summary>
    private string _brandSubtitle => Role switch
    {
        "teacher" => "教师端 \u00b7 智能考勤",
        "student" => "学生端 \u00b7 智能考勤",
        _ => "智能考勤 \u00b7 高效管理"
    };

    /// <summary>根据角色参数动态生成表单标题</summary>
    private string _formTitle => Role switch
    {
        "teacher" => "教师登录",
        "student" => "学生登录",
        _ => "欢迎回来"
    };

    protected override void OnInitialized()
    {
        _errorMessage = ErrorMessage switch
        {
            "invalid" => "用户名或密码错误",
            "empty" => "用户名和密码不能为空",
            _ => null
        };
    }

    /// <summary>
    /// 滑块验证码验证通过回调
    /// </summary>
    private void OnCaptchaVerified(string token)
    {
        _captchaToken = token;
    }
}
