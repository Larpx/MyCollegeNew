@page "/student/checkin"
@layout StudentLayout
@attribute [Authorize(Roles = "Student")]
@rendermode InteractiveServer
@using System.IdentityModel.Tokens.Jwt
@using Microsoft.JSInterop
@using Larpx.PersonalTools.MyCollegeNew.Shared.Enums
@using Larpx.PersonalTools.MyCollegeNew.Shared.Features.Attendance
@inject IApiClient ApiClient
@inject TokenService TokenService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<Components.Pages.Student.CheckIn> Logger
@implements IDisposable

<PageTitle>快捷签到 - 考勤管理系统</PageTitle>

<PageHeader Title="快捷签到" Icon="qr-code" Subtitle="扫码或输入签到码完成考勤签到" />

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert--error">
        <span class="alert__icon"><Icon Name="alert-circle" Size="20" /></span>
        <span class="alert__body">@_errorMessage</span>
    </div>
}

<Card>
    @* 扫码签到区域 *@
    <div class="qr-scanner-area">
        @if (_scanning)
        {
            <video id="qr-video" class="qr-scanner-area__video" autoplay playsinline muted></video>
            <div class="qr-scanner-area__hint">将摄像头对准教师屏幕上的二维码</div>
            <Button Variant="ButtonVariant.Secondary" Icon="x" OnClick="StopScannerAsync">取消扫码</Button>
        }
        else
        {
            <Button Variant="ButtonVariant.Primary" Icon="camera" OnClick="StartScannerAsync" Loading="_scannerStarting">
                扫码签到
            </Button>
            <div class="qr-scanner-area__hint">点击按钮使用摄像头扫描二维码</div>
            <div class="student-checkin-divider">
                <span>或手动输入签到码</span>
            </div>
        }
    </div>

    @* 手动输入签到码 *@
    @if (!_scanning)
    {
        <div class="student-form-field">
            <label class="student-form-field__label">签到码</label>
            <input class="student-checkin-input"
                   type="text"
                   placeholder="请输入签到码"
                   value="@_token"
                   @oninput="OnTokenChanged"
                   autocomplete="off"
                   maxlength="512" />
        </div>

        <Button Variant="ButtonVariant.Primary"
                Icon="check-circle"
                OnClick="CheckInAsync"
                Loading="_submitting"
                Disabled="string.IsNullOrWhiteSpace(_token)"
                Class="student-btn-large">
            签到
        </Button>
    }

    @* 签到结果反馈 *@
    @if (_checkInResult is not null)
    {
        var isSuccess = _checkInResult.Status == AttendanceStatus.Present || _checkInResult.Status == AttendanceStatus.Late;
        <div class="student-checkin-result @(isSuccess ? "student-checkin-result--success" : "student-checkin-result--error")">
            <span class="student-checkin-result__icon">
                <Icon Name="@(isSuccess ? "check-circle" : "x-circle")" Size="24" />
            </span>
            <div class="student-checkin-result__body">
                <div class="student-checkin-result__title">@(isSuccess ? "签到成功" : "签到失败")</div>
                <div class="student-checkin-result__meta">
                    @if (isSuccess)
                    {
                        <text>状态：@GetStatusName(_checkInResult.Status) | 签到时间：@_checkInResult.CheckInTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</text>
                    }
                    else
                    {
                        <text>@_checkInResult.Message</text>
                    }
                </div>
            </div>
        </div>
    }
</Card>

@code {
    private string _token = string.Empty;
    private bool _submitting;
    private bool _scanning;
    private bool _scannerStarting;
    private string? _errorMessage;
    private CheckInResult? _checkInResult;
    private string _studentId = string.Empty;
    private DotNetObjectReference<Components.Pages.Student.CheckIn>? _dotNetRef;

    protected override void OnInitialized()
    {
        var userInfo = TokenService.GetUserInfo();
        if (userInfo is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }
        _studentId = userInfo.UserId;
    }

    /// <summary>启动摄像头扫码</summary>
    private async Task StartScannerAsync()
    {
        _scannerStarting = true;
        _errorMessage = null;
        try
        {
            // 先检查浏览器是否支持
            var supported = await JSRuntime.InvokeAsync<bool>("qrScanner.isSupported");
            if (!supported)
            {
                _errorMessage = "当前浏览器不支持扫码功能，请使用 Chrome 或 Edge 浏览器，或手动输入签到码";
                return;
            }

            _scanning = true;
            _dotNetRef ??= DotNetObjectReference.Create(this);

            // 等待 video 元素渲染
            await Task.Delay(100);

            var result = await JSRuntime.InvokeAsync<ScannerResult>("qrScanner.start", "qr-video", _dotNetRef);
            if (!result.Success)
            {
                _scanning = false;
                _errorMessage = result.Error;
            }
        }
        catch (Exception ex)
        {
            _scanning = false;
            _errorMessage = "启动扫码失败：" + ex.Message;
            Logger.LogError(ex, "启动扫码异常");
        }
        finally
        {
            _scannerStarting = false;
        }
    }

    /// <summary>停止扫码</summary>
    private async Task StopScannerAsync()
    {
        await JSRuntime.InvokeVoidAsync("qrScanner.stop");
        _scanning = false;
    }

    /// <summary>JS 回调：扫码成功</summary>
    [JSInvokable]
    public async Task OnQrCodeScanned(string token)
    {
        _scanning = false;
        _token = token;
        _checkInResult = null;
        _errorMessage = null;
        StateHasChanged();
        // 扫码成功后自动签到
        await CheckInAsync();
    }

    /// <summary>签到码输入变更</summary>
    private void OnTokenChanged(ChangeEventArgs e)
    {
        _token = e.Value?.ToString() ?? string.Empty;
        _checkInResult = null;
        _errorMessage = null;
    }

    /// <summary>执行签到</summary>
    private async Task CheckInAsync()
    {
        if (string.IsNullOrWhiteSpace(_token))
        {
            _errorMessage = "请输入签到码";
            return;
        }

        _submitting = true;
        _errorMessage = null;
        _checkInResult = null;

        try
        {
            var sessionId = ExtractSessionIdFromToken(_token);
            if (sessionId is null)
            {
                _errorMessage = "签到码格式无效，请检查后重新输入";
                return;
            }

            var request = new CheckInRequestDto { Token = _token };
            _checkInResult = await ApiClient.PostAsync<CheckInResult>($"sessions/{sessionId.Value}/checkin", request);
        }
        catch (ApiException ex)
        {
            _errorMessage = string.IsNullOrEmpty(ex.ApiMessage) ? "签到失败，请稍后重试" : ex.ApiMessage;
            Logger.LogWarning(ex, "学生签到失败");
        }
        catch (Exception ex)
        {
            _errorMessage = "签到失败，请稍后重试";
            Logger.LogError(ex, "学生签到异常");
        }
        finally
        {
            _submitting = false;
        }
    }

    /// <summary>从 JWT 签到码中解析会话 ID</summary>
    private static long? ExtractSessionIdFromToken(string token)
    {
        try
        {
            var handler = new JwtSecurityTokenHandler();
            var jwt = handler.ReadJwtToken(token);
            var sessionIdClaim = jwt.Claims.FirstOrDefault(c => c.Type == "session_id");
            if (sessionIdClaim is not null && long.TryParse(sessionIdClaim.Value, out var sessionId))
            {
                return sessionId;
            }
            return null;
        }
        catch
        {
            return null;
        }
    }

    /// <summary>获取考勤状态中文名称</summary>
    private static string GetStatusName(AttendanceStatus status) => status switch
    {
        AttendanceStatus.Present => "正常",
        AttendanceStatus.Late => "迟到",
        AttendanceStatus.Absent => "缺勤",
        AttendanceStatus.Leave => "请假",
        _ => "未知"
    };

    public void Dispose()
    {
        if (_scanning)
        {
            _ = JSRuntime.InvokeVoidAsync("qrScanner.stop");
        }
        _dotNetRef?.Dispose();
    }

    /// <summary>JS 扫码结果返回结构</summary>
    private sealed class ScannerResult
    {
        public bool Success { get; set; }
        public string Error { get; set; } = string.Empty;
    }
}
