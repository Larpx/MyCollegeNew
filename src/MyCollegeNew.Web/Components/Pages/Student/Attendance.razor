@page "/student/attendance"
@layout StudentLayout
@attribute [Authorize(Roles = "Student")]
@rendermode InteractiveServer
@using Larpx.PersonalTools.MyCollegeNew.Shared.Enums
@using Larpx.PersonalTools.MyCollegeNew.Shared.Features.Statistics
@inject IApiClient ApiClient
@inject TokenService TokenService
@inject NavigationManager NavigationManager
@inject ILogger<Components.Pages.Student.Attendance> Logger

<PageTitle>我的考勤 - 考勤管理系统</PageTitle>

<PageHeader Title="我的考勤" Icon="bar-chart" Subtitle="查看出勤率与考勤记录">
    <Actions>
        <Button Variant="ButtonVariant.Secondary" Icon="refresh-cw" OnClick="LoadDataAsync" Loading="_loading">刷新</Button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert--error">
        <span class="alert__icon"><Icon Name="alert-circle" Size="20" /></span>
        <span class="alert__body">@_errorMessage</span>
    </div>
}

@if (_loading && _statistics is null)
{
    <div class="loading-state">
        <span class="loading-state__spinner"></span>
        <span>加载中...</span>
    </div>
}
else if (_statistics is not null)
{
    @* 顶部统计卡片：出勤率、迟到、缺勤、请假 *@
    <div class="student-stats-grid">
        <Card>
            <div class="student-rate-card">
                <div class="student-rate-card__value">@(_statistics.AttendanceRate.ToString("F1"))%</div>
                <div class="student-rate-card__label">本学期出勤率</div>
            </div>
        </Card>
        <Card>
            <div class="stat-card">
                <span class="stat-card__icon stat-card__icon--warning"><Icon Name="clock" Size="24" /></span>
                <div class="stat-card__body">
                    <div class="stat-card__label">迟到次数</div>
                    <div class="stat-card__value">@_statistics.LateCount</div>
                </div>
            </div>
        </Card>
        <Card>
            <div class="stat-card">
                <span class="stat-card__icon stat-card__icon--error"><Icon Name="x-circle" Size="24" /></span>
                <div class="stat-card__body">
                    <div class="stat-card__label">缺勤次数</div>
                    <div class="stat-card__value">@_statistics.AbsentCount</div>
                </div>
            </div>
        </Card>
        <Card>
            <div class="stat-card">
                <span class="stat-card__icon"><Icon Name="file-text" Size="24" /></span>
                <div class="stat-card__body">
                    <div class="stat-card__label">请假次数</div>
                    <div class="stat-card__value">@_statistics.LeaveCount</div>
                </div>
            </div>
        </Card>
    </div>

    @* 课程维度统计：每门课程的出勤率进度条 *@
    <Card Title="课程出勤率" Class="mb-6">
        @if (_statistics.CourseStatistics is null || _statistics.CourseStatistics.Count == 0)
        {
            <EmptyState Title="暂无课程数据" Description="还没有课程考勤记录" Icon="book-open" />
        }
        else
        {
            @foreach (var course in _statistics.CourseStatistics)
            {
                var fillClass = course.AttendanceRate >= 90 ? "student-progress__fill--success"
                    : course.AttendanceRate >= 75 ? "student-progress__fill--warning"
                    : "student-progress__fill--error";
                <div class="student-progress">
                    <div class="student-progress__header">
                        <span class="student-progress__name">@course.CourseName</span>
                        <span class="student-progress__value">@course.AttendanceRate.ToString("F1")% (@course.TotalSessions 节)</span>
                    </div>
                    <div class="student-progress__track">
                        <div class="student-progress__fill @fillClass" style="width: @(Math.Max(2, course.AttendanceRate))%;"></div>
                    </div>
                </div>
            }
        }
    </Card>

    @* 考勤汇总信息 *@
    <Card Title="考勤汇总">
        <div class="info-list">
            <div class="info-list__item">
                <span class="info-list__label">总会话数</span>
                <span class="info-list__value">@_statistics.TotalSessions</span>
            </div>
            <div class="info-list__item">
                <span class="info-list__label">正常出勤</span>
                <span class="info-list__value">@_statistics.PresentCount 次</span>
            </div>
            <div class="info-list__item">
                <span class="info-list__label">迟到</span>
                <span class="info-list__value">@_statistics.LateCount 次</span>
            </div>
            <div class="info-list__item">
                <span class="info-list__label">缺勤</span>
                <span class="info-list__value">@_statistics.AbsentCount 次</span>
            </div>
            <div class="info-list__item">
                <span class="info-list__label">请假</span>
                <span class="info-list__value">@_statistics.LeaveCount 次</span>
            </div>
        </div>
    </Card>
}

@code {
    private StudentStatisticsDto? _statistics;
    private bool _loading;
    private string? _errorMessage;
    private string _studentId = string.Empty;

    /// <summary>
    /// 页面初始化：获取当前学生学号并加载统计数据
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var userInfo = TokenService.GetUserInfo();
        if (userInfo is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        _studentId = userInfo.UserId;
        await LoadDataAsync();
    }

    /// <summary>加载学生个人考勤统计</summary>
    private async Task LoadDataAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            _statistics = await ApiClient.GetAsync<StudentStatisticsDto>($"api/statistics/student/{_studentId}");
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
            Logger.LogWarning(ex, "加载学生考勤统计失败");
        }
        catch (Exception ex)
        {
            _errorMessage = "加载数据失败，请稍后重试";
            Logger.LogError(ex, "加载学生考勤统计异常");
        }
        finally
        {
            _loading = false;
        }
    }
}
