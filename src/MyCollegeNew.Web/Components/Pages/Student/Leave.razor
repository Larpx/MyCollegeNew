@page "/student/leaves"
@page "/student/leave"
@layout StudentLayout
@attribute [Authorize(Roles = "Student")]
@rendermode InteractiveServer
@using Larpx.PersonalTools.MyCollegeNew.Shared.Enums
@using Larpx.PersonalTools.MyCollegeNew.Shared.Features.Leave
@inject IApiClient ApiClient
@inject TokenService TokenService
@inject NavigationManager NavigationManager
@inject ILogger<Components.Pages.Student.Leave> Logger

<PageTitle>请假申请 - 考勤管理系统</PageTitle>

<PageHeader Title="请假申请" Icon="file-text" Subtitle="提交请假申请，查看审批状态" />

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert--error">
        <span class="alert__icon"><Icon Name="alert-circle" Size="20" /></span>
        <span class="alert__body">@_errorMessage</span>
    </div>
}

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert--success">
        <span class="alert__icon"><Icon Name="check-circle" Size="20" /></span>
        <span class="alert__body">@_successMessage</span>
    </div>
}

@* 标签页导航：请假申请 / 历史记录 *@
<div class="tab-bar">
    <button type="button"
            class="tab-bar__item @(_activeTab == "apply" ? "tab-bar__item--active" : "")"
            onclick="() => SwitchTab("apply")">
        <Icon Name="plus" Size="16" />
        <span>请假申请</span>
    </button>
    <button type="button"
            class="tab-bar__item @(_activeTab == "history" ? "tab-bar__item--active" : "")"
            @onclick='() => SwitchTab("history")'>
        <Icon Name="list" Size="16" />
        <span>历史记录</span>
    </button>
</div>

@if (_activeTab == "apply")
{
    @* 请假申请表单 *@
    <Card Title="填写请假申请">
        <div class="student-form-field">
            <label class="student-form-field__label student-form-field__label--required">请假类型</label>
            <select class="student-form-field__input" @bind="_leaveType">
                <option value="@LeaveType.Sick">病假</option>
                <option value="@LeaveType.Personal">事假</option>
                <option value="@LeaveType.Official">公假</option>
                <option value="@LeaveType.Other">其他</option>
            </select>
        </div>

        <div class="student-form-field">
            <label class="student-form-field__label student-form-field__label--required">开始时间</label>
            <input class="student-form-field__input"
                   type="datetime-local"
                   @bind="_startTime"
                   @bind:format="yyyy-MM-ddTHH:mm" />
        </div>

        <div class="student-form-field">
            <label class="student-form-field__label student-form-field__label--required">结束时间</label>
            <input class="student-form-field__input"
                   type="datetime-local"
                   @bind="_endTime"
                   @bind:format="yyyy-MM-ddTHH:mm" />
            @if (_endTime <= _startTime)
            {
                <span class="student-form-field__error">结束时间必须晚于开始时间</span>
            }
        </div>

        <div class="student-form-field">
            <label class="student-form-field__label student-form-field__label--required">请假原因</label>
            <textarea class="student-form-field__input"
                      placeholder="请详细说明请假原因（最多 512 字）"
                      maxlength="512"
                      @bind="_reason"></textarea>
        </div>

        <Button Variant="ButtonVariant.Primary"
                Icon="send"
                OnClick="SubmitLeaveAsync"
                Loading="_submitting"
                Disabled="!IsFormValid()"
                Class="student-btn-large">
            提交申请
        </Button>
    </Card>
}
else
{
    @* 历史记录列表 *@
    @if (_loading && _leaves is null)
    {
        <div class="loading-state">
            <span class="loading-state__spinner"></span>
            <span>加载中...</span>
        </div>
    }
    else if (_leaves is null || _leaves.Items.Count == 0)
    {
        <Card>
            <EmptyState Title="暂无请假记录" Description="您还没有提交过请假申请" Icon="inbox" />
        </Card>
    }
    else
    {
        <Card Title="请假记录">
            @foreach (var leave in _leaves.Items)
            {
                <div class="student-leave-card">
                    <div class="student-leave-card__header">
                        <span class="student-leave-card__type">@GetLeaveTypeName(leave.LeaveType)</span>
                        @RenderStatusBadge(leave.Status)
                    </div>
                    <div class="student-leave-card__time">
                        @leave.StartTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ~ @leave.EndTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    </div>
                    <div class="student-leave-card__reason">@leave.Reason</div>
                    @if (!string.IsNullOrEmpty(leave.ReviewRemark))
                    {
                        <div class="student-leave-card__remark">审批备注：@leave.ReviewRemark</div>
                    }
                </div>
            }

            @if (_leaves.Total > _leaves.Items.Count)
            {
                <div class="text-sm text-secondary mt-4 text-center">
                    共 @_leaves.Total 条记录，当前显示前 @_leaves.Items.Count 条
                </div>
            }
        </Card>
    }
}

@code {
    private string _activeTab = "apply";
    private PagedResult<LeaveResponseDto>? _leaves;
    private bool _loading;
    private bool _submitting;
    private string? _errorMessage;
    private string? _successMessage;

    // 表单字段（datetime-local 输入需要本地时间，统一以 UtcNow 为源再转本地时间）
    private LeaveType _leaveType = LeaveType.Sick;
    private DateTime _startTime = DateTime.UtcNow.ToLocalTime();
    private DateTime _endTime = DateTime.UtcNow.ToLocalTime().AddHours(2);
    private string _reason = string.Empty;

    /// <summary>
    /// 页面初始化：预加载历史记录
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var userInfo = TokenService.GetUserInfo();
        if (userInfo is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        await LoadLeavesAsync();
    }

    /// <summary>切换标签页</summary>
    private async Task SwitchTab(string tab)
    {
        _activeTab = tab;
        _errorMessage = null;
        _successMessage = null;
        if (tab == "history" && _leaves is null)
        {
            await LoadLeavesAsync();
        }
    }

    /// <summary>加载我的请假记录</summary>
    private async Task LoadLeavesAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            _leaves = await ApiClient.GetAsync<PagedResult<LeaveResponseDto>>("api/leaves/my?pageIndex=1&pageSize=50");
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
            Logger.LogWarning(ex, "加载请假记录失败");
        }
        catch (Exception ex)
        {
            _errorMessage = "加载请假记录失败，请稍后重试";
            Logger.LogError(ex, "加载请假记录异常");
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>提交请假申请</summary>
    private async Task SubmitLeaveAsync()
    {
        if (!IsFormValid())
        {
            return;
        }

        _submitting = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var dto = new LeaveCreateDto
            {
                LeaveType = _leaveType,
                StartTime = _startTime.ToUniversalTime(),
                EndTime = _endTime.ToUniversalTime(),
                Reason = _reason
            };

            await ApiClient.PostAsync<LeaveResponseDto>("api/leaves", dto);
            _successMessage = "请假申请已提交，请等待辅导员审批";

            // 重置表单
            _reason = string.Empty;
            _leaveType = LeaveType.Sick;
            _startTime = DateTime.UtcNow.ToLocalTime();
            _endTime = DateTime.UtcNow.ToLocalTime().AddHours(2);

            // 刷新历史记录
            _leaves = null;
            await LoadLeavesAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
            Logger.LogWarning(ex, "提交请假申请失败");
        }
        catch (Exception ex)
        {
            _errorMessage = "提交失败，请稍后重试";
            Logger.LogError(ex, "提交请假申请异常");
        }
        finally
        {
            _submitting = false;
        }
    }

    /// <summary>校验表单是否有效</summary>
    private bool IsFormValid()
    {
        return !string.IsNullOrWhiteSpace(_reason) && _endTime > _startTime;
    }

    /// <summary>获取请假类型中文名称</summary>
    private static string GetLeaveTypeName(LeaveType type) => type switch
    {
        LeaveType.Sick => "病假",
        LeaveType.Personal => "事假",
        LeaveType.Official => "公假",
        LeaveType.Other => "其他",
        _ => "未知"
    };

    /// <summary>渲染审批状态徽章</summary>
    private static RenderFragment RenderStatusBadge(LeaveStatus status)
    {
        var (text, variant) = status switch
        {
            LeaveStatus.Pending => ("待审批", BadgeVariant.Warning),
            LeaveStatus.Approved => ("已通过", BadgeVariant.Success),
            LeaveStatus.Rejected => ("已驳回", BadgeVariant.Error),
            _ => ("未知", BadgeVariant.Neutral)
        };
        return @<Badge Variant="variant">@text</Badge>;
    }
}
