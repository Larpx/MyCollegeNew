@page "/student/home"
@layout StudentLayout
@attribute [Authorize(Roles = "Student")]
@rendermode InteractiveServer
@using Larpx.PersonalTools.MyCollegeNew.Shared.Features.Attendance
@using Larpx.PersonalTools.MyCollegeNew.Shared.Features.Courses
@inject IApiClient ApiClient
@inject TokenService TokenService
@inject NavigationManager NavigationManager
@inject ILogger<Components.Pages.Student.Home> Logger

<PageTitle>学生首页 - 考勤管理系统</PageTitle>

<PageHeader Title="学生首页" Icon="home" Subtitle="@($"欢迎回来，{_userName}")">
    <Actions>
        <Button Variant="ButtonVariant.Secondary" Icon="refresh-cw" OnClick="LoadDataAsync" Loading="_loading">刷新</Button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert--error">
        <span class="alert__icon"><Icon Name="alert-circle" Size="20" /></span>
        <span class="alert__body">@_errorMessage</span>
    </div>
}

@if (_loading && _todaySchedules is null)
{
    <div class="loading-state">
        <span class="loading-state__spinner"></span>
        <span>加载中...</span>
    </div>
}
else
{
    @* 三快捷卡片：1步可达的核心功能 *@
    <div class="student-quick-actions">
        @* 快捷签到卡片：有进行中会话时高亮 *@
        <button type="button"
                class="student-quick-action student-quick-action--primary @(_hasActiveSession ? "student-quick-action--highlight" : "")"
                onclick="GoToCheckIn">
            <span class="student-quick-action__icon">
                <Icon Name="qr-code" Size="24" />
            </span>
            <div class="student-quick-action__body">
                <div class="student-quick-action__title">快捷签到</div>
                <div class="student-quick-action__hint">
                    @if (_hasActiveSession)
                    {
                        <text>现在可以签到</text>
                    }
                    else
                    {
                        <text>点击进入签到页面</text>
                    }
                </div>
            </div>
            @if (_hasActiveSession)
            {
                <span class="student-quick-action__badge">
                    <Badge Variant="BadgeVariant.Success">可签到</Badge>
                </span>
            }
        </button>

        @* 请假申请卡片 *@
        <button type="button"
                class="student-quick-action student-quick-action--warning"
                onclick="GoToLeave">
            <span class="student-quick-action__icon student-quick-action__icon--warning">
                <Icon Name="file-text" Size="24" />
            </span>
            <div class="student-quick-action__body">
                <div class="student-quick-action__title">请假申请</div>
                <div class="student-quick-action__hint">提交请假申请，查看审批状态</div>
            </div>
        </button>

        @* 我的考勤卡片 *@
        <button type="button"
                class="student-quick-action student-quick-action--success"
                onclick="GoToAttendance">
            <span class="student-quick-action__icon student-quick-action__icon--success">
                <Icon Name="bar-chart" Size="24" />
            </span>
            <div class="student-quick-action__body">
                <div class="student-quick-action__title">我的考勤</div>
                <div class="student-quick-action__hint">查看出勤率与考勤记录</div>
            </div>
        </button>
    </div>

    @* 今日课程列表 *@
    <Card Title="今日课程">
        @if (_todaySchedules is null || _todaySchedules.Count == 0)
        {
            <EmptyState Title="今日无课" Description="今天没有排课记录" Icon="calendar-days" />
        }
        else
        {
            <div class="course-card-list">
                @foreach (var schedule in _todaySchedules)
                {
                    <div class="course-card-item">
                        <span class="course-card-item__section">第@(schedule.StartSection)-@(schedule.EndSection)节</span>
                        <div class="course-card-item__body">
                            <div class="course-card-item__title">@schedule.CourseName</div>
                            <div class="course-card-item__meta">
                                <span class="course-card-item__meta-item"><Icon Name="map-pin" Size="16" />@schedule.Classroom</span>
                                <span class="course-card-item__meta-item"><Icon Name="user" Size="16" />@schedule.TeacherName</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </Card>
}

@code {
    private List<ScheduleResponseDto>? _todaySchedules;
    private bool _hasActiveSession;
    private bool _loading;
    private string? _errorMessage;
    private string _userId = string.Empty;
    private string _userName = string.Empty;

    /// <summary>
    /// 页面初始化：获取当前学生信息并加载今日课表与进行中会话
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var userInfo = TokenService.GetUserInfo();
        if (userInfo is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        _userId = userInfo.UserId;
        _userName = userInfo.UserName;
        await LoadDataAsync();
    }

    /// <summary>
    /// 并行加载今日课表与进行中会话状态
    /// </summary>
    private async Task LoadDataAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            // 计算今日星期几（1=周一, 7=周日）
            var today = DateTime.UtcNow;
            var dayOfWeek = (int)today.DayOfWeek;
            if (dayOfWeek == 0) dayOfWeek = 7; // 周日转为 7

            // 加载本周课表，从中提取今日课程
            var weekly = await ApiClient.GetAsync<WeeklyScheduleDto>($"api/schedules/by-student/{_userId}?week=1");
            _todaySchedules = weekly?.Days?.GetValueOrDefault(dayOfWeek) ?? new List<ScheduleResponseDto>();

            // 尝试获取进行中会话（学生端可能无权限，失败时忽略）
            try
            {
                var activeSessions = await ApiClient.GetAsync<List<SessionResponseDto>>("api/sessions/active");
                _hasActiveSession = activeSessions is not null && activeSessions.Count > 0;
            }
            catch (ApiException)
            {
                // 学生端可能无权访问 active 端点，忽略错误
                _hasActiveSession = false;
            }
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
            Logger.LogWarning(ex, "加载学生首页数据失败");
        }
        catch (Exception ex)
        {
            _errorMessage = "加载数据失败，请稍后重试";
            Logger.LogError(ex, "加载学生首页数据异常");
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>跳转到签到页</summary>
    private void GoToCheckIn()
    {
        NavigationManager.NavigateTo("/student/checkin");
    }

    /// <summary>跳转到请假申请页</summary>
    private void GoToLeave()
    {
        NavigationManager.NavigateTo("/student/leaves");
    }

    /// <summary>跳转到考勤统计页</summary>
    private void GoToAttendance()
    {
        NavigationManager.NavigateTo("/student/attendance");
    }
}
