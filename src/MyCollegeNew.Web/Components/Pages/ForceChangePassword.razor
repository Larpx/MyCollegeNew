@page "/force-change-password"
@layout LoginLayout
@inject IHttpContextAccessor HttpContextAccessor
@inject IAntiforgery Antiforgery

<PageTitle>修改初始密码 - 考勤管理系统</PageTitle>

@{
    var httpContext = HttpContextAccessor.HttpContext;
    var tokenSet = httpContext is not null
        ? Antiforgery.GetAndStoreTokens(httpContext)
        : null;
    var requestToken = tokenSet?.RequestToken ?? string.Empty;
}

<div class="login-page">
    <div class="login-page__brand">
        <div class="login-page__deco login-page__deco--1"></div>
        <div class="login-page__deco login-page__deco--2"></div>
        <div class="login-page__deco login-page__deco--3"></div>

        <div class="login-page__brand-content">
            <div class="login-page__brand-icon">
                <Icon Name="graduation-cap" Size="40" />
            </div>
            <h1 class="login-page__brand-title">考勤管理系统</h1>
            <p class="login-page__brand-subtitle">学生端 · 智能考勤</p>
            <p class="login-page__brand-quote">首次登录请修改初始密码</p>
        </div>
    </div>

    <div class="login-page__form-side">
        <div class="login-form">
            <div class="login-form__header">
                <h2 class="login-form__title">修改初始密码</h2>
                <p class="login-form__subtitle">为保护账号安全，请修改初始密码后继续</p>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert--error" role="alert">
                    <Icon Name="alert-circle" Size="18" />
                    <span>@_errorMessage</span>
                </div>
            }

            @if (string.IsNullOrEmpty(_twoFactorToken))
            {
                <div class="alert alert--error" role="alert">
                    <Icon Name="alert-circle" Size="18" />
                    <span>临时令牌已过期，请重新登录</span>
                </div>
                <a href="/login" class="login-form__submit" style="display:inline-block;text-align:center;text-decoration:none;">
                    返回登录
                </a>
            }
            else
            {
                <form method="post" action="/auth/force-change-password" class="login-form__form" onsubmit="return validateForceChangePassword();">
                    <input type="hidden" name="__RequestVerificationToken" value="@requestToken" />
                    <input type="hidden" name="TwoFactorToken" value="@_twoFactorToken" />

                    <div class="ui-input-wrapper">
                        <span class="ui-input-icon">
                            <Icon Name="lock" Size="18" />
                        </span>
                        <input id="newPassword" name="NewPassword" type="password" class="ui-input"
                               placeholder="新密码（至少8位，含大小写字母与数字）" required
                               autocomplete="new-password" minlength="8" maxlength="128" />
                    </div>

                    <div class="ui-input-wrapper">
                        <span class="ui-input-icon">
                            <Icon Name="lock" Size="18" />
                        </span>
                        <input id="confirmPassword" type="password" class="ui-input"
                               placeholder="确认新密码" required autocomplete="new-password"
                               minlength="8" maxlength="128" />
                    </div>

                    <button type="submit" class="login-form__submit">
                        <span>确认修改</span>
                    </button>
                </form>
            }
        </div>
    </div>
</div>

<script>
    // 前端基础校验：两次输入一致 + 密码复杂度（与服务端 L-1 规则一致）
    function validateForceChangePassword() {
        var pwd = document.getElementById('newPassword').value;
        var confirm = document.getElementById('confirmPassword').value;
        if (pwd !== confirm) {
            alert('两次输入的密码不一致');
            return false;
        }
        if (pwd.length < 8) {
            alert('密码长度不能少于8位');
            return false;
        }
        if (!/[A-Z]/.test(pwd) || !/[a-z]/.test(pwd) || !/[0-9]/.test(pwd)) {
            alert('密码必须包含至少一个大写字母、一个小写字母和一个数字');
            return false;
        }
        return true;
    }
</script>

@code {
    /// <summary>从查询参数获取错误消息</summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorMessage { get; set; }

    /// <summary>从 Cookie 读取的强制改密临时令牌</summary>
    private string? _twoFactorToken;

    /// <summary>错误消息</summary>
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        // 从 Cookie 读取临时令牌
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is not null)
        {
            _twoFactorToken = httpContext.Request.Cookies["force_pwd_token"];
        }

        _errorMessage = ErrorMessage switch
        {
            "empty" => "新密码不能为空",
            "invalid" => "密码修改失败，请重试",
            _ => ErrorMessage
        };
    }
}
