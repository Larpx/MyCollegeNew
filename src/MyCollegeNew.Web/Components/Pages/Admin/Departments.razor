@page "/admin/departments"
@layout AdminLayout
@attribute [Authorize]
@rendermode InteractiveServer
@using Larpx.PersonalTools.MyCollegeNew.Shared.Enums
@using Larpx.PersonalTools.MyCollegeNew.Shared.Features.Organization
@inject IApiClient ApiClient
@inject ILogger<Components.Pages.Admin.Departments> Logger

<PageTitle>院系管理 - 考勤管理系统</PageTitle>

<PageHeader Title="院系管理" Icon="building" Subtitle="管理院系、专业、班级三级组织架构">
    <Actions>
        <Button Variant="ButtonVariant.Primary" Icon="plus" OnClick="OpenCreateDepartmentModal">新增院系</Button>
        <Button Variant="ButtonVariant.Secondary" Icon="refresh-cw" OnClick="LoadTreeAsync" Loading="_loading">刷新</Button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert--error">
        <span class="alert__icon"><Icon Name="alert-circle" Size="20" /></span>
        <span class="alert__body">@_errorMessage</span>
    </div>
}

@if (_loading && _tree is null)
{
    <div class="loading-state">
        <span class="loading-state__spinner"></span>
        <span>加载中...</span>
    </div>
}
else if (_tree is null || _tree.Count == 0)
{
    <EmptyState Title="暂无院系数据" Description="点击右上角「新增院系」开始创建组织架构" Icon="building">
        <Actions>
            <Button Variant="ButtonVariant.Primary" Icon="plus" OnClick="OpenCreateDepartmentModal">新增院系</Button>
        </Actions>
    </EmptyState>
}
else
{
    <div class="split-layout">
        @* 左侧：组织架构树 *@
        <div class="split-layout__sidebar">
            <div class="tree-view">
                @foreach (var deptNode in _tree)
                {
                    <DepartmentNode DeptNode="deptNode"
                                    OnEditDepartment="OpenEditDepartmentModal"
                                    OnDeleteDepartment="OpenDeleteDepartmentModal"
                                    OnAddMajor="OpenCreateMajorModal"
                                    OnEditMajor="OpenEditMajorModal"
                                    OnDeleteMajor="OpenDeleteMajorModal"
                                    OnAddClass="OpenCreateClassModal"
                                    OnEditClass="OpenEditClassModal"
                                    OnDeleteClass="OpenDeleteClassModal" />
                }
            </div>
        </div>

        @* 右侧：统计概览 *@
        <div class="split-layout__main">
            <Card Title="组织架构概览">
                <div class="info-list">
                    <div class="info-list__item">
                        <span class="info-list__label">院系总数</span>
                        <span class="info-list__value">@_tree.Count</span>
                    </div>
                    <div class="info-list__item">
                        <span class="info-list__label">专业总数</span>
                        <span class="info-list__value">@(_tree.Sum(d => d.Majors.Count))</span>
                    </div>
                    <div class="info-list__item">
                        <span class="info-list__label">班级总数</span>
                        <span class="info-list__value">@(_tree.Sum(d => d.Majors.Sum(m => m.Classes.Count)))</span>
                    </div>
                    <div class="info-list__item">
                        <span class="info-list__label">学生总数</span>
                        <span class="info-list__value">@(_tree.Sum(d => d.Department.StudentCount))</span>
                    </div>
                </div>
            </Card>

            <Card Title="操作提示" Class="mt-4">
                <div class="info-list">
                    <div class="info-list__item">
                        <span class="info-list__label">提示</span>
                        <span class="info-list__value">将鼠标悬停在树节点上，会出现操作按钮，可进行编辑、删除及下级新增。</span>
                    </div>
                    <div class="info-list__item">
                        <span class="info-list__label">删除规则</span>
                        <span class="info-list__value">删除院系将同时删除其下所有专业与班级；删除专业将同时删除其下所有班级。请谨慎操作。</span>
                    </div>
                </div>
            </Card>
        </div>
    </div>
}

@* 院系新增/编辑 Modal *@
<Modal Visible="_deptModalVisible" Title="@_deptModalTitle" OnClose="CloseDeptModal">
    <ChildContent>
        <div class="form-grid form-grid--single">
            <div class="form-field">
                <label class="form-field__label form-field__label--required">院系名称</label>
                <input class="form-field__input" @bind="_deptForm.Name" placeholder="请输入院系名称" maxlength="64" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseDeptModal">取消</Button>
        <Button Variant="ButtonVariant.Primary" Icon="save" OnClick="SaveDepartmentAsync" Loading="_saving">保存</Button>
    </Footer>
</Modal>

@* 专业新增/编辑 Modal *@
<Modal Visible="_majorModalVisible" Title="@_majorModalTitle" OnClose="CloseMajorModal">
    <ChildContent>
        <div class="form-grid form-grid--single">
            <div class="form-field">
                <label class="form-field__label">所属院系</label>
                <input class="form-field__input" value="@_majorFormDepartmentName" disabled />
            </div>
            <div class="form-field">
                <label class="form-field__label form-field__label--required">专业名称</label>
                <input class="form-field__input" @bind="_majorForm.Name" placeholder="请输入专业名称" maxlength="64" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseMajorModal">取消</Button>
        <Button Variant="ButtonVariant.Primary" Icon="save" OnClick="SaveMajorAsync" Loading="_saving">保存</Button>
    </Footer>
</Modal>

@* 班级新增/编辑 Modal *@
<Modal Visible="_classModalVisible" Title="@_classModalTitle" OnClose="CloseClassModal">
    <ChildContent>
        <div class="form-grid">
            <div class="form-field">
                <label class="form-field__label">所属专业</label>
                <input class="form-field__input" value="@_classFormMajorName" disabled />
            </div>
            <div class="form-field">
                <label class="form-field__label form-field__label--required">班级名称</label>
                <input class="form-field__input" @bind="_classForm.Name" placeholder="如：计科2201" maxlength="64" />
            </div>
            <div class="form-field">
                <label class="form-field__label form-field__label--required">年级</label>
                <input type="number" class="form-field__input" @bind="_classForm.Grade" placeholder="如：2022" min="1900" max="2100" />
            </div>
            <div class="form-field">
                <label class="form-field__label form-field__label--required">辅导员工号</label>
                <input class="form-field__input" @bind="_classForm.CounselorId" placeholder="请输入辅导员工号" maxlength="32" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseClassModal">取消</Button>
        <Button Variant="ButtonVariant.Primary" Icon="save" OnClick="SaveClassAsync" Loading="_saving">保存</Button>
    </Footer>
</Modal>

@* 删除确认 Modal *@
<Modal Visible="_deleteModalVisible" Title="删除确认" OnClose="CloseDeleteModal">
    <ChildContent>
        <div class="alert alert--warning">
            <span class="alert__icon"><Icon Name="alert-triangle" Size="20" /></span>
            <span class="alert__body">@_deleteConfirmText</span>
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseDeleteModal">取消</Button>
        <Button Variant="ButtonVariant.Danger" Icon="trash" OnClick="ConfirmDeleteAsync" Loading="_saving">确认删除</Button>
    </Footer>
</Modal>

@code {
    private List<OrganizationTreeNodeDto>? _tree;
    private bool _loading;
    private bool _saving;
    private string? _errorMessage;

    // Modal 状态
    private bool _deptModalVisible;
    private string _deptModalTitle = string.Empty;
    private DepartmentForm _deptForm = new();
    private long? _editingDeptId;

    private bool _majorModalVisible;
    private string _majorModalTitle = string.Empty;
    private MajorForm _majorForm = new();
    private long? _editingMajorId;
    private string _majorFormDepartmentName = string.Empty;

    private bool _classModalVisible;
    private string _classModalTitle = string.Empty;
    private ClassForm _classForm = new();
    private long? _editingClassId;
    private string _classFormMajorName = string.Empty;

    private bool _deleteModalVisible;
    private string _deleteConfirmText = string.Empty;
    private Func<Task>? _deleteAction;

    /// <summary>院系表单</summary>
    private sealed class DepartmentForm
    {
        /// <summary>院系名称</summary>
        public string Name { get; set; } = string.Empty;
    }

    /// <summary>专业表单</summary>
    private sealed class MajorForm
    {
        /// <summary>专业名称</summary>
        public string Name { get; set; } = string.Empty;

        /// <summary>所属院系 Id</summary>
        public long DepartmentId { get; set; }
    }

    /// <summary>班级表单</summary>
    private sealed class ClassForm
    {
        /// <summary>班级名称</summary>
        public string Name { get; set; } = string.Empty;

        /// <summary>年级</summary>
        public int Grade { get; set; } = DateTime.UtcNow.Year;

        /// <summary>辅导员工号</summary>
        public string CounselorId { get; set; } = string.Empty;

        /// <summary>所属专业 Id</summary>
        public long MajorId { get; set; }
    }

    /// <summary>页面初始化：加载组织架构树</summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadTreeAsync();
    }

    /// <summary>加载组织架构树</summary>
    private async Task LoadTreeAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            _tree = await ApiClient.GetAsync<List<OrganizationTreeNodeDto>>("organization/tree");
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
            Logger.LogWarning(ex, "加载组织架构树失败");
        }
        catch (Exception ex)
        {
            _errorMessage = "加载组织架构树失败，请稍后重试";
            Logger.LogError(ex, "加载组织架构树异常");
        }
        finally
        {
            _loading = false;
        }
    }

    // ---------- 院系 CRUD ----------

    /// <summary>打开新增院系 Modal</summary>
    private void OpenCreateDepartmentModal()
    {
        _editingDeptId = null;
        _deptModalTitle = "新增院系";
        _deptForm = new DepartmentForm();
        _deptModalVisible = true;
    }

    /// <summary>打开编辑院系 Modal</summary>
    private void OpenEditDepartmentModal(DepartmentResponseDto dept)
    {
        _editingDeptId = dept.Id;
        _deptModalTitle = "编辑院系";
        _deptForm = new DepartmentForm { Name = dept.Name };
        _deptModalVisible = true;
    }

    /// <summary>关闭院系 Modal</summary>
    private void CloseDeptModal() => _deptModalVisible = false;

    /// <summary>保存院系（新增或编辑）</summary>
    private async Task SaveDepartmentAsync()
    {
        if (string.IsNullOrWhiteSpace(_deptForm.Name))
        {
            _errorMessage = "院系名称不能为空";
            return;
        }

        _saving = true;
        _errorMessage = null;
        try
        {
            if (_editingDeptId.HasValue)
            {
                var dto = new DepartmentUpdateDto { Name = _deptForm.Name.Trim() };
                await ApiClient.PutAsync<DepartmentResponseDto>($"departments/{_editingDeptId.Value}", dto);
            }
            else
            {
                var dto = new DepartmentCreateDto { Name = _deptForm.Name.Trim() };
                await ApiClient.PostAsync<DepartmentResponseDto>("departments", dto);
            }
            _deptModalVisible = false;
            await LoadTreeAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "保存院系失败，请稍后重试";
            Logger.LogError(ex, "保存院系异常");
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>打开删除院系确认</summary>
    private void OpenDeleteDepartmentModal(DepartmentResponseDto dept)
    {
        _deleteConfirmText = $"确定删除院系「{dept.Name}」吗？该操作将同时删除其下所有专业与班级，且不可恢复。";
        _deleteAction = async () =>
        {
            await ApiClient.DeleteAsync<object>($"departments/{dept.Id}");
            await LoadTreeAsync();
        };
        _deleteModalVisible = true;
    }

    // ---------- 专业 CRUD ----------

    /// <summary>打开新增专业 Modal</summary>
    private void OpenCreateMajorModal(DepartmentResponseDto dept)
    {
        _editingMajorId = null;
        _majorModalTitle = "新增专业";
        _majorForm = new MajorForm { DepartmentId = dept.Id };
        _majorFormDepartmentName = dept.Name;
        _majorModalVisible = true;
    }

    /// <summary>打开编辑专业 Modal</summary>
    private void OpenEditMajorModal(MajorResponseDto major)
    {
        _editingMajorId = major.Id;
        _majorModalTitle = "编辑专业";
        _majorForm = new MajorForm { Name = major.Name, DepartmentId = major.DepartmentId };
        _majorFormDepartmentName = major.DepartmentName;
        _majorModalVisible = true;
    }

    /// <summary>关闭专业 Modal</summary>
    private void CloseMajorModal() => _majorModalVisible = false;

    /// <summary>保存专业</summary>
    private async Task SaveMajorAsync()
    {
        if (string.IsNullOrWhiteSpace(_majorForm.Name))
        {
            _errorMessage = "专业名称不能为空";
            return;
        }
        if (_majorForm.DepartmentId <= 0)
        {
            _errorMessage = "请选择所属院系";
            return;
        }

        _saving = true;
        _errorMessage = null;
        try
        {
            if (_editingMajorId.HasValue)
            {
                var dto = new MajorUpdateDto { Name = _majorForm.Name.Trim(), DepartmentId = _majorForm.DepartmentId };
                await ApiClient.PutAsync<MajorResponseDto>($"majors/{_editingMajorId.Value}", dto);
            }
            else
            {
                var dto = new MajorCreateDto { Name = _majorForm.Name.Trim(), DepartmentId = _majorForm.DepartmentId };
                await ApiClient.PostAsync<MajorResponseDto>("majors", dto);
            }
            _majorModalVisible = false;
            await LoadTreeAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "保存专业失败，请稍后重试";
            Logger.LogError(ex, "保存专业异常");
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>打开删除专业确认</summary>
    private void OpenDeleteMajorModal(MajorResponseDto major)
    {
        _deleteConfirmText = $"确定删除专业「{major.Name}」吗？该操作将同时删除其下所有班级，且不可恢复。";
        _deleteAction = async () =>
        {
            await ApiClient.DeleteAsync<object>($"majors/{major.Id}");
            await LoadTreeAsync();
        };
        _deleteModalVisible = true;
    }

    // ---------- 班级 CRUD ----------

    /// <summary>打开新增班级 Modal</summary>
    private void OpenCreateClassModal(MajorResponseDto major)
    {
        _editingClassId = null;
        _classModalTitle = "新增班级";
        _classForm = new ClassForm { Grade = DateTime.UtcNow.Year, MajorId = major.Id };
        _classFormMajorName = major.Name;
        _classModalVisible = true;
    }

    /// <summary>打开编辑班级 Modal</summary>
    private void OpenEditClassModal(ClassResponseDto cls)
    {
        _editingClassId = cls.Id;
        _classModalTitle = "编辑班级";
        _classForm = new ClassForm
        {
            Name = cls.Name,
            Grade = cls.Grade,
            CounselorId = cls.CounselorId,
            MajorId = cls.MajorId
        };
        _classFormMajorName = cls.MajorName;
        _classModalVisible = true;
    }

    /// <summary>关闭班级 Modal</summary>
    private void CloseClassModal() => _classModalVisible = false;

    /// <summary>保存班级</summary>
    private async Task SaveClassAsync()
    {
        if (string.IsNullOrWhiteSpace(_classForm.Name))
        {
            _errorMessage = "班级名称不能为空";
            return;
        }
        if (string.IsNullOrWhiteSpace(_classForm.CounselorId))
        {
            _errorMessage = "辅导员工号不能为空";
            return;
        }
        if (_classForm.MajorId <= 0)
        {
            _errorMessage = "请选择所属专业";
            return;
        }

        _saving = true;
        _errorMessage = null;
        try
        {
            if (_editingClassId.HasValue)
            {
                var dto = new ClassUpdateDto
                {
                    Name = _classForm.Name.Trim(),
                    MajorId = _classForm.MajorId,
                    Grade = _classForm.Grade,
                    CounselorId = _classForm.CounselorId.Trim()
                };
                await ApiClient.PutAsync<ClassResponseDto>($"classes/{_editingClassId.Value}", dto);
            }
            else
            {
                var dto = new ClassCreateDto
                {
                    Name = _classForm.Name.Trim(),
                    MajorId = _classForm.MajorId,
                    Grade = _classForm.Grade,
                    CounselorId = _classForm.CounselorId.Trim()
                };
                await ApiClient.PostAsync<ClassResponseDto>("classes", dto);
            }
            _classModalVisible = false;
            await LoadTreeAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "保存班级失败，请稍后重试";
            Logger.LogError(ex, "保存班级异常");
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>打开删除班级确认</summary>
    private void OpenDeleteClassModal(ClassResponseDto cls)
    {
        _deleteConfirmText = $"确定删除班级「{cls.Name}」吗？该操作不可恢复。";
        _deleteAction = async () =>
        {
            await ApiClient.DeleteAsync<object>($"classes/{cls.Id}");
            await LoadTreeAsync();
        };
        _deleteModalVisible = true;
    }

    // ---------- 删除确认通用 ----------

    /// <summary>关闭删除确认 Modal</summary>
    private void CloseDeleteModal()
    {
        _deleteModalVisible = false;
        _deleteAction = null;
    }

    /// <summary>执行删除操作</summary>
    private async Task ConfirmDeleteAsync()
    {
        if (_deleteAction is null) return;
        _saving = true;
        _errorMessage = null;
        try
        {
            await _deleteAction.Invoke();
            _deleteModalVisible = false;
            _deleteAction = null;
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "删除失败，请稍后重试";
            Logger.LogError(ex, "删除组织节点异常");
        }
        finally
        {
            _saving = false;
        }
    }
}
