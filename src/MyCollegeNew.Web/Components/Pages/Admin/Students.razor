@page "/admin/students"
@layout AdminLayout
@attribute [Authorize]
@rendermode InteractiveServer
@using Larpx.PersonalTools.MyCollegeNew.Shared.Features.Organization
@using Larpx.PersonalTools.MyCollegeNew.Shared.Features.Users
@inject IApiClient ApiClient
@inject ILogger<Components.Pages.Admin.Students> Logger

<PageTitle>学生管理 - 考勤管理系统</PageTitle>

<PageHeader Title="学生管理" Icon="users" Subtitle="管理学生账号与基本信息">
    <Actions>
        <Button Variant="ButtonVariant.Secondary" Icon="refresh-cw" OnClick="LoadStudentsAsync" Loading="_loading">刷新</Button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert--error">
        <span class="alert__icon"><Icon Name="alert-circle" Size="20" /></span>
        <span class="alert__body">@_errorMessage</span>
    </div>
}

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert--success">
        <span class="alert__icon"><Icon Name="check-circle" Size="20" /></span>
        <span class="alert__body">@_successMessage</span>
    </div>
}

@* 过滤器工具栏 *@
<div class="page-filters">
    <div class="page-filters__field">
        <label class="page-filters__label">关键字</label>
        <InputText @bind-Value="_keyword" placeholder="学号 / 姓名" class="form-field__input" />
    </div>
    <div class="page-filters__field">
        <label class="page-filters__label">院系</label>
        <select class="page-filters__select" @bind="_filterDepartmentId">
            <option value="">全部院系</option>
            @foreach (var dept in _departments)
            {
                <option value="@dept.Id">@dept.Name</option>
            }
        </select>
    </div>
    <div class="page-filters__field">
        <label class="page-filters__label">班级</label>
        <select class="page-filters__select" @bind="_filterClassId" disabled="@(_availableClasses.Count == 0)">
            <option value="">全部班级</option>
            @foreach (var cls in _availableClasses)
            {
                <option value="@cls.Id">@cls.Name</option>
            }
        </select>
    </div>
    <div class="page-filters__actions">
        <Button Variant="ButtonVariant.Secondary" Icon="search" OnClick="SearchAsync">查询</Button>
        <Button Variant="ButtonVariant.Primary" Icon="plus" OnClick="OpenCreateModal">新增学生</Button>
        <Button Variant="ButtonVariant.Outline" Icon="upload" OnClick="OpenImportModal">CSV 导入</Button>
    </div>
</div>

@* 学生列表 *@
@if (_loading && _students is null)
{
    <div class="loading-state">
        <span class="loading-state__spinner"></span>
        <span>加载中...</span>
    </div>
}
else
{
    <Card>
        <Table T="StudentResponseDto"
               Items="_students?.Items"
               Columns="_columns"
               ShowPagination="true"
               PageIndex="_pageIndex"
               PageSize="_pageSize"
               TotalCount="(int)(_students?.Total ?? 0)"
               PageChanged="OnPageChanged" />
    </Card>
}

@* 新增/编辑 Modal *@
<Modal Visible="_formModalVisible" Title="@_formModalTitle" OnClose="CloseFormModal">
    <ChildContent>
        <div class="form-grid">
            <div class="form-field">
                <label class="form-field__label form-field__label--required">学号</label>
                <input class="form-field__input" @bind="_form.Id" placeholder="请输入学号" maxlength="32" disabled="@_isEdit" />
            </div>
            <div class="form-field">
                <label class="form-field__label form-field__label--required">姓名</label>
                <input class="form-field__input" @bind="_form.Name" placeholder="请输入姓名" maxlength="32" />
            </div>
            @if (!_isEdit)
            {
                <div class="form-field">
                    <label class="form-field__label form-field__label--required">登录密码</label>
                    <input type="password" class="form-field__input" @bind="_form.Password" placeholder="至少 6 位" maxlength="128" />
                </div>
            }
            <div class="form-field">
                <label class="form-field__label form-field__label--required">性别</label>
                <select class="form-field__input" @bind="_form.Gender">
                    <option value="">请选择</option>
                    <option value="男">男</option>
                    <option value="女">女</option>
                </select>
            </div>
            <div class="form-field">
                <label class="form-field__label form-field__label--required">院系</label>
                <select class="form-field__input" value="@_form.DepartmentId" @onchange="OnDepartmentChanged">
                    <option value="0">请选择</option>
                    @foreach (var dept in _departments)
                    {
                        <option value="@dept.Id">@dept.Name</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label class="form-field__label form-field__label--required">专业</label>
                <select class="form-field__input" value="@_form.MajorId" @onchange="OnMajorChanged" disabled="@(_formMajors.Count == 0)">
                    <option value="0">请选择</option>
                    @foreach (var major in _formMajors)
                    {
                        <option value="@major.Id">@major.Name</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label class="form-field__label form-field__label--required">班级</label>
                <select class="form-field__input" @bind="_form.ClassId" disabled="@(_formClasses.Count == 0)">
                    <option value="0">请选择</option>
                    @foreach (var cls in _formClasses)
                    {
                        <option value="@cls.Id">@cls.Name</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label class="form-field__label form-field__label--required">年级</label>
                <input type="number" class="form-field__input" @bind="_form.Grade" placeholder="如：2022" min="1900" max="2100" />
            </div>
            @if (_isEdit)
            {
                <div class="form-field">
                    <label class="form-field__label">在读状态</label>
                    <select class="form-field__input" @bind="_form.Status">
                        <option value="0">在读</option>
                        <option value="1">休学</option>
                        <option value="2">毕业</option>
                    </select>
                </div>
                <div class="form-field form-field--full">
                    <label class="form-field__label">备注</label>
                    <input class="form-field__input" @bind="_form.Remark" placeholder="备注信息" maxlength="256" />
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseFormModal">取消</Button>
        <Button Variant="ButtonVariant.Primary" Icon="save" OnClick="SaveAsync" Loading="_saving">保存</Button>
    </Footer>
</Modal>

@* CSV 导入 Modal *@
<Modal Visible="_importModalVisible" Title="CSV 批量导入" OnClose="CloseImportModal">
    <ChildContent>
        <div class="form-grid form-grid--single">
            <div class="alert alert--info">
                <span class="alert__icon"><Icon Name="info" Size="20" /></span>
                <span class="alert__body">CSV 文件格式：学号,姓名,密码,性别,院系Id,专业Id,班级Id,年级。首行为表头。</span>
            </div>
            <div class="form-field">
                <label class="form-field__label form-field__label--required">选择 CSV 文件</label>
                <InputFile OnChange="OnFileSelectedAsync" accept=".csv" class="file-upload__input" />
                <span class="form-field__hint">已选择：@(_selectedFileName ?? "未选择")</span>
            </div>
            @if (_importResult is not null)
            {
                <div class="alert alert--@(_importResult.FailedCount > 0 ? "warning" : "success")">
                    <span class="alert__icon"><Icon Name="@(_importResult.FailedCount > 0 ? "alert-triangle" : "check-circle")" Size="20" /></span>
                    <span class="alert__body">
                        导入完成：成功 @_importResult.SuccessCount 条，失败 @_importResult.FailedCount 条。
                        @if (_importResult.FailedCount > 0)
                        {
                            <ul class="mt-2">
                                @foreach (var fail in _importResult.Failures.Take(5))
                                {
                                    <li>第 @fail.Row 行：@fail.Reason</li>
                                }
                                @if (_importResult.Failures.Count > 5)
                                {
                                    <li>...共 @_importResult.Failures.Count 条失败</li>
                                }
                            </ul>
                        }
                    </span>
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseImportModal">关闭</Button>
        <Button Variant="ButtonVariant.Primary" Icon="upload" OnClick="ImportAsync" Loading="_saving" Disabled="(_selectedFile is null)">开始导入</Button>
    </Footer>
</Modal>

@* 删除确认 Modal *@
<Modal Visible="_deleteModalVisible" Title="删除确认" OnClose="CloseDeleteModal">
    <ChildContent>
        <div class="alert alert--warning">
            <span class="alert__icon"><Icon Name="alert-triangle" Size="20" /></span>
            <span class="alert__body">确定删除学生「@_deletingStudent?.Name」（@_deletingStudent?.Id）吗？该操作为软删除，后续可恢复。</span>
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseDeleteModal">取消</Button>
        <Button Variant="ButtonVariant.Danger" Icon="trash" OnClick="ConfirmDeleteAsync" Loading="_saving">确认删除</Button>
    </Footer>
</Modal>

@code {
    private PagedResult<StudentResponseDto>? _students;
    private List<DepartmentResponseDto> _departments = new();
    private List<ClassResponseDto> _availableClasses = new();
    private List<MajorResponseDto> _formMajors = new();
    private List<ClassResponseDto> _formClasses = new();

    private int _pageIndex = 1;
    private int _pageSize = 10;
    private string _keyword = string.Empty;
    private long? _filterDepartmentId;
    private long? _filterClassId;

    private bool _loading;
    private bool _saving;
    private string? _errorMessage;
    private string? _successMessage;

    // 表单状态
    private bool _formModalVisible;
    private string _formModalTitle = string.Empty;
    private bool _isEdit;
    private StudentForm _form = new();
    private string? _editingId;

    // 导入状态
    private bool _importModalVisible;
    private IBrowserFile? _selectedFile;
    private string? _selectedFileName;
    private BatchImportResultDto? _importResult;

    // 删除状态
    private bool _deleteModalVisible;
    private StudentResponseDto? _deletingStudent;

    private List<Table<StudentResponseDto>.Column<StudentResponseDto>> _columns = new();

    /// <summary>学生表单</summary>
    private sealed class StudentForm
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Gender { get; set; } = string.Empty;
        public long DepartmentId { get; set; }
        public long MajorId { get; set; }
        public long ClassId { get; set; }
        public int Grade { get; set; } = DateTime.UtcNow.Year;
        public int Status { get; set; }
        public string? Remark { get; set; }
    }

    /// <summary>页面初始化</summary>
    protected override async Task OnInitializedAsync()
    {
        BuildColumns();
        await LoadDepartmentsAsync();
        await LoadStudentsAsync();
    }

    /// <summary>构建表格列</summary>
    private void BuildColumns()
    {
        _columns = new List<Table<StudentResponseDto>.Column<StudentResponseDto>>
        {
            new() { Title = "学号", Template = item => @<span class="font-medium">@item.Id</span> },
            new() { Title = "姓名", Template = item => @<span>@item.Name</span> },
            new() { Title = "性别", Template = item => @<span>@item.Gender</span> },
            new() { Title = "院系", Template = item => @<span>@item.DepartmentName</span> },
            new() { Title = "专业", Template = item => @<span>@item.MajorName</span> },
            new() { Title = "班级", Template = item => @<span>@item.ClassName</span> },
            new() { Title = "状态", Template = item => RenderStatusBadge(item.Status) },
            new() { Title = "操作", Template = item => RenderActions(item) }
        };
    }

    /// <summary>渲染状态徽章</summary>
    private RenderFragment RenderStatusBadge(int status)
    {
        var (text, variant) = status switch
        {
            0 => ("在读", BadgeVariant.Success),
            1 => ("休学", BadgeVariant.Warning),
            2 => ("毕业", BadgeVariant.Neutral),
            _ => ("未知", BadgeVariant.Neutral)
        };
        return @<Badge Variant="variant">@text</Badge>;
    }

    /// <summary>渲染行操作按钮</summary>
    private RenderFragment RenderActions(StudentResponseDto item) => @<span class="table-actions">
        <button type="button" class="table-action-btn" @onclick="() => OpenEditModal(item)" title="编辑" aria-label="编辑">
            <Icon Name="edit" Size="16" />
        </button>
        <button type="button" class="table-action-btn table-action-btn--danger" @onclick="() => OpenDeleteModal(item)" title="删除" aria-label="删除">
            <Icon Name="trash" Size="16" />
        </button>
    </span>;

    /// <summary>加载院系列表（用于过滤和表单下拉）</summary>
    private async Task LoadDepartmentsAsync()
    {
        try
        {
            _departments = await ApiClient.GetAsync<List<DepartmentResponseDto>>("departments") ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载院系列表失败");
        }
    }

    /// <summary>加载学生分页数据</summary>
    private async Task LoadStudentsAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            var url = $"students?pageIndex={_pageIndex}&pageSize={_pageSize}";
            if (!string.IsNullOrWhiteSpace(_keyword)) url += $"&keyword={Uri.EscapeDataString(_keyword.Trim())}";
            if (_filterClassId.HasValue) url += $"&classId={_filterClassId.Value}";
            _students = await ApiClient.GetAsync<PagedResult<StudentResponseDto>>(url);
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "加载学生列表失败，请稍后重试";
            Logger.LogError(ex, "加载学生列表异常");
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>查询按钮：重置页码后加载</summary>
    private async Task SearchAsync()
    {
        _pageIndex = 1;
        await LoadStudentsAsync();
    }

    /// <summary>分页变更</summary>
    private async Task OnPageChanged(int newPage)
    {
        _pageIndex = newPage;
        await LoadStudentsAsync();
    }

    /// <summary>院系变更时加载该院系下的班级（用于过滤）</summary>
    private async Task OnFilterDepartmentChanged()
    {
        _filterClassId = null;
        _availableClasses.Clear();
        if (_filterDepartmentId.HasValue)
        {
            try
            {
                var majors = await ApiClient.GetAsync<List<MajorResponseDto>>($"departments/{_filterDepartmentId.Value}/majors") ?? new();
                foreach (var major in majors)
                {
                    var classes = await ApiClient.GetAsync<List<ClassResponseDto>>($"majors/{major.Id}/classes") ?? new();
                    _availableClasses.AddRange(classes);
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "加载过滤班级列表失败");
            }
        }
    }

    /// <summary>表单院系变更：加载专业列表</summary>
    private async Task OnDepartmentChanged(ChangeEventArgs e)
    {
        _form.MajorId = 0;
        _form.ClassId = 0;
        _formMajors.Clear();
        _formClasses.Clear();
        if (long.TryParse(e.Value?.ToString(), out var deptId) && deptId > 0)
        {
            _form.DepartmentId = deptId;
            try
            {
                _formMajors = await ApiClient.GetAsync<List<MajorResponseDto>>($"departments/{deptId}/majors") ?? new();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "加载专业列表失败");
            }
        }
        else
        {
            _form.DepartmentId = 0;
        }
    }

    /// <summary>表单专业变更：加载班级列表</summary>
    private async Task OnMajorChanged(ChangeEventArgs e)
    {
        _form.ClassId = 0;
        _formClasses.Clear();
        if (long.TryParse(e.Value?.ToString(), out var majorId) && majorId > 0)
        {
            _form.MajorId = majorId;
            try
            {
                _formClasses = await ApiClient.GetAsync<List<ClassResponseDto>>($"majors/{majorId}/classes") ?? new();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "加载班级列表失败");
            }
        }
        else
        {
            _form.MajorId = 0;
        }
    }

    // ---------- 表单 ----------

    /// <summary>打开新增 Modal</summary>
    private void OpenCreateModal()
    {
        _isEdit = false;
        _editingId = null;
        _formModalTitle = "新增学生";
        _form = new StudentForm { Grade = DateTime.UtcNow.Year };
        _formMajors.Clear();
        _formClasses.Clear();
        _formModalVisible = true;
    }

    /// <summary>打开编辑 Modal</summary>
    private async Task OpenEditModal(StudentResponseDto student)
    {
        _isEdit = true;
        _editingId = student.Id;
        _formModalTitle = "编辑学生";
        _form = new StudentForm
        {
            Id = student.Id,
            Name = student.Name,
            Gender = student.Gender,
            Grade = student.Grade,
            Status = student.Status,
            Remark = student.Remark
        };
        _formMajors.Clear();
        _formClasses.Clear();
        _formModalVisible = true;

        // 由于 StudentResponseDto 不含 DepartmentId/MajorId/ClassId，需要根据名称匹配
        // 这里简化处理：让管理员重新选择院系/专业/班级
    }

    /// <summary>关闭表单 Modal</summary>
    private void CloseFormModal() => _formModalVisible = false;

    /// <summary>保存学生</summary>
    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Id) && !_isEdit)
        {
            _errorMessage = "学号不能为空";
            return;
        }
        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _errorMessage = "姓名不能为空";
            return;
        }
        if (!_isEdit && _form.Password.Length < 6)
        {
            _errorMessage = "密码长度至少 6 位";
            return;
        }
        if (_form.DepartmentId <= 0 || _form.MajorId <= 0 || _form.ClassId <= 0)
        {
            _errorMessage = "请选择院系、专业、班级";
            return;
        }

        _saving = true;
        _errorMessage = null;
        _successMessage = null;
        try
        {
            if (_isEdit && _editingId is not null)
            {
                var dto = new StudentUpdateDto
                {
                    Name = _form.Name.Trim(),
                    Gender = _form.Gender,
                    DepartmentId = _form.DepartmentId,
                    MajorId = _form.MajorId,
                    ClassId = _form.ClassId,
                    Grade = _form.Grade,
                    Status = _form.Status,
                    Remark = _form.Remark
                };
                await ApiClient.PutAsync<StudentResponseDto>($"students/{_editingId}", dto);
                _successMessage = "学生信息已更新";
            }
            else
            {
                var dto = new StudentCreateDto
                {
                    Id = _form.Id.Trim(),
                    Name = _form.Name.Trim(),
                    Password = _form.Password,
                    Gender = _form.Gender,
                    DepartmentId = _form.DepartmentId,
                    MajorId = _form.MajorId,
                    ClassId = _form.ClassId,
                    Grade = _form.Grade
                };
                await ApiClient.PostAsync<StudentResponseDto>("students", dto);
                _successMessage = "学生创建成功";
            }
            _formModalVisible = false;
            await LoadStudentsAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "保存学生失败，请稍后重试";
            Logger.LogError(ex, "保存学生异常");
        }
        finally
        {
            _saving = false;
        }
    }

    // ---------- 删除 ----------

    /// <summary>打开删除确认</summary>
    private void OpenDeleteModal(StudentResponseDto student)
    {
        _deletingStudent = student;
        _deleteModalVisible = true;
    }

    /// <summary>关闭删除确认</summary>
    private void CloseDeleteModal()
    {
        _deleteModalVisible = false;
        _deletingStudent = null;
    }

    /// <summary>确认删除</summary>
    private async Task ConfirmDeleteAsync()
    {
        if (_deletingStudent is null) return;
        _saving = true;
        _errorMessage = null;
        try
        {
            await ApiClient.DeleteAsync<object>($"students/{_deletingStudent.Id}");
            _deleteModalVisible = false;
            _deletingStudent = null;
            _successMessage = "学生已删除";
            await LoadStudentsAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "删除失败，请稍后重试";
            Logger.LogError(ex, "删除学生异常");
        }
        finally
        {
            _saving = false;
        }
    }

    // ---------- CSV 导入 ----------

    /// <summary>打开导入 Modal</summary>
    private void OpenImportModal()
    {
        _importResult = null;
        _selectedFile = null;
        _selectedFileName = null;
        _importModalVisible = true;
    }

    /// <summary>关闭导入 Modal</summary>
    private void CloseImportModal() => _importModalVisible = false;

    /// <summary>文件选择回调</summary>
    private void OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _selectedFileName = e.File.Name;
        _importResult = null;
    }

    /// <summary>执行 CSV 导入</summary>
    private async Task ImportAsync()
    {
        if (_selectedFile is null) return;
        _saving = true;
        _errorMessage = null;
        try
        {
            // 限制文件大小 10MB
            await using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var content = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(memoryStream.ToArray());
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("text/csv");
            content.Add(fileContent, "file", _selectedFile.Name);

            // 使用 PostFormAsync 以 multipart/form-data 方式上传
            _importResult = await ApiClient.PostFormAsync<BatchImportResultDto>("students/import", content);
            _successMessage = $"导入完成：成功 {_importResult?.SuccessCount ?? 0} 条";
            await LoadStudentsAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "导入失败，请检查文件格式";
            Logger.LogError(ex, "CSV 导入异常");
        }
        finally
        {
            _saving = false;
        }
    }
}
