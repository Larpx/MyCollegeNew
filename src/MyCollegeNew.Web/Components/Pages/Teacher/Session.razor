@page "/teacher/session/{SessionId:long}"
@page "/teacher/session/new"
@layout TeacherLayout
@attribute [Authorize]
@rendermode InteractiveServer
@using Larpx.PersonalTools.MyCollegeNew.Shared.Enums
@using Larpx.PersonalTools.MyCollegeNew.Shared.Features.Attendance
@inject IApiClient ApiClient
@inject TokenService TokenService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<Components.Pages.Teacher.Session> Logger

<PageTitle>考勤会话 - 考勤管理系统</PageTitle>

<PageHeader Title="考勤会话" Icon="qr-code" Subtitle="@(_session?.CourseName ?? "新建会话")">
    <Actions>
        <Button Variant="ButtonVariant.Secondary" Icon="arrow-left" OnClick="GoBack">返回</Button>
        @if (_session is not null && _session.Status == SessionStatus.Active)
        {
            <Button Variant="ButtonVariant.Danger" Icon="stop" OnClick="CloseSessionAsync" Loading="_operating">关闭会话</Button>
        }
    </Actions>
</PageHeader>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert--error">
        <span class="alert__icon"><Icon Name="alert-circle" Size="20" /></span>
        <span class="alert__body">@_errorMessage</span>
    </div>
}

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert--success">
        <span class="alert__icon"><Icon Name="check-circle" Size="20" /></span>
        <span class="alert__body">@_successMessage</span>
    </div>
}

@if (_loading)
{
    <div class="loading-state">
        <span class="loading-state__spinner"></span>
        <span>加载中...</span>
    </div>
}
else if (_isNew && _session is null)
{
    @* 新建会话表单 *@
    <Card Title="发起考勤会话">
        <div class="form-grid form-grid--single">
            <div class="form-field">
                <label class="form-field__label form-field__label--required">课程 Id</label>
                <input class="form-field__input" value="@_newCourseId" readonly />
            </div>
            <div class="form-field">
                <label class="form-field__label form-field__label--required">班级 Id</label>
                <input class="form-field__input" value="@_newClassId" readonly />
            </div>
            <div class="form-field">
                <label class="form-field__label">签到时长（分钟）</label>
                <input type="number" class="form-field__input" @bind="_durationMinutes" min="1" max="120" />
            </div>
            <div class="flex gap-2">
                <Button Variant="ButtonVariant.Primary" Icon="play" OnClick="CreateSessionAsync" Loading="_operating">开始考勤</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoBack">取消</Button>
            </div>
        </div>
    </Card>
}
else if (_session is not null)
{
    <div class="split-layout">
        @* 左侧：二维码展示 *@
        <div class="split-layout__sidebar">
            <Card Title="签到二维码">
                @if (_session.Status == SessionStatus.Active)
                {
                    @if (_qrCode is not null)
                    {
                        <div class="qr-display">
                            <img class="qr-display__image" src="data:image/png;base64,@_qrCode.Base64Image" alt="签到二维码" />
                            <div class="qr-display__countdown">
                                <span>剩余有效时间：</span>
                                <span class="qr-display__countdown-value">@_countdown 秒</span>
                            </div>
                            <Button Variant="ButtonVariant.Secondary" Icon="refresh-cw" OnClick="RefreshQrCodeAsync" Loading="_operating">立即刷新</Button>
                        </div>
                    }
                    else
                    {
                        <div class="loading-state">
                            <span class="loading-state__spinner"></span>
                            <span>生成二维码中...</span>
                        </div>
                        <div class="mt-4 flex justify-between">
                            <Button Variant="ButtonVariant.Primary" Icon="qr-code" OnClick="GenerateQrCodeAsync" Loading="_operating">生成二维码</Button>
                        </div>
                    }
                }
                else
                {
                    <EmptyState Title="会话已关闭" Description="该考勤会话已结束" Icon="stop" />
                }
            </Card>

            <Card Title="会话信息" Class="mt-4">
                <div class="info-list">
                    <div class="info-list__item">
                        <span class="info-list__label">课程</span>
                        <span class="info-list__value">@_session.CourseName</span>
                    </div>
                    <div class="info-list__item">
                        <span class="info-list__label">班级</span>
                        <span class="info-list__value">@_session.ClassName</span>
                    </div>
                    <div class="info-list__item">
                        <span class="info-list__label">开始时间</span>
                        <span class="info-list__value">@_session.StartTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                    <div class="info-list__item">
                        <span class="info-list__label">结束时间</span>
                        <span class="info-list__value">@_session.EndTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                    <div class="info-list__item">
                        <span class="info-list__label">状态</span>
                        <span class="info-list__value">
                            @if (_session.Status == SessionStatus.Active)
                            {
                                <Badge Variant="BadgeVariant.Success">进行中</Badge>
                            }
                            else
                            {
                                <Badge Variant="BadgeVariant.Neutral">已关闭</Badge>
                            }
                        </span>
                    </div>
                </div>
            </Card>
        </div>

        @* 右侧：签到记录与操作 *@
        <div class="split-layout__main">
            <Card Title="操作">
                <div class="dashboard-actions">
                    @if (_session.Status == SessionStatus.Active)
                    {
                        <Button Variant="ButtonVariant.Primary" Icon="check-square" OnClick="RollCallAllAsync" Loading="_operating">一键点名</Button>
                        <Button Variant="ButtonVariant.Secondary" Icon="user-plus" OnClick="GoToManualCheckIn">手动补签</Button>
                        <Button Variant="ButtonVariant.Secondary" Icon="shuffle" OnClick="() => GoToRollCall(_session.Id)">随机点名</Button>
                        <Button Variant="ButtonVariant.Outline" Icon="download" OnClick="ExportRecordsAsync" Loading="_exporting">导出记录</Button>
                    }
                </div>
            </Card>

            <Card Title="签到记录" Class="mt-4">
                @if (_records is null || _records.Count == 0)
                {
                    <EmptyState Title="暂无签到记录" Description="学生扫码后将显示在此处" Icon="clipboard-list" />
                }
                else
                {
                    <div class="mb-4 text-sm text-secondary">
                        已签到：@_records.Count(r => r.Status != AttendanceStatus.Absent) / @_records.Count 人
                    </div>
                    <Table T="AttendanceRecordResponseDto" Items="_records" Columns="_recordColumns" />
                }
            </Card>
        </div>
    </div>
}

@code {
    [Parameter]
    public long SessionId { get; set; }

    private SessionResponseDto? _session;
    private QrCodeResult? _qrCode;
    private List<AttendanceRecordResponseDto>? _records;
    private int _countdown;
    private bool _loading;
    private bool _operating;
    private bool _exporting;
    private string? _errorMessage;
    private string? _successMessage;

    // 新建会话相关
    private bool _isNew;
    private long _newCourseId;
    private long _newClassId;
    private long? _newScheduleId;
    private int _durationMinutes = 30;

    private List<Table<AttendanceRecordResponseDto>.Column<AttendanceRecordResponseDto>> _recordColumns = new();

    /// <summary>页面初始化</summary>
    protected override async Task OnInitializedAsync()
    {
        BuildRecordColumns();
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        // 判断是否为新建会话路由
        if (uri.AbsolutePath.EndsWith("/new", StringComparison.OrdinalIgnoreCase))
        {
            _isNew = true;
            _newCourseId = long.TryParse(query.Get("courseId"), out var courseId) ? courseId : 0;
            _newClassId = long.TryParse(query.Get("classId"), out var classId) ? classId : 0;
            _newScheduleId = long.TryParse(query.Get("scheduleId"), out var scheduleId) ? scheduleId : null;
        }
        else
        {
            _isNew = false;
            await LoadSessionAsync();
        }
    }

    /// <summary>构建签到记录表格列</summary>
    private void BuildRecordColumns()
    {
        _recordColumns = new List<Table<AttendanceRecordResponseDto>.Column<AttendanceRecordResponseDto>>
        {
            new() { Title = "学号", Template = item => @<span class="font-medium">@item.StudentId</span> },
            new() { Title = "姓名", Template = item => @<span>@item.StudentName</span> },
            new() { Title = "状态", Template = item => RenderStatusBadge(item.Status) },
            new() { Title = "签到时间", Template = item => @<span class="text-secondary">@(item.CheckInTime.HasValue ? item.CheckInTime.Value.ToLocalTime().ToString("HH:mm:ss") : "—")</span> },
            new() { Title = "操作", Template = item => RenderRecordActions(item) }
        };
    }

    /// <summary>渲染考勤状态徽章</summary>
    private RenderFragment RenderStatusBadge(AttendanceStatus status)
    {
        var (text, variant) = status switch
        {
            AttendanceStatus.Present => ("正常", BadgeVariant.Success),
            AttendanceStatus.Late => ("迟到", BadgeVariant.Warning),
            AttendanceStatus.Absent => ("缺勤", BadgeVariant.Error),
            AttendanceStatus.Leave => ("请假", BadgeVariant.Primary),
            _ => ("未知", BadgeVariant.Neutral)
        };
        return @<Badge Variant="variant">@text</Badge>;
    }

    /// <summary>渲染记录操作按钮</summary>
    private RenderFragment RenderRecordActions(AttendanceRecordResponseDto item) => @<span class="table-actions">
        <select class="status-select" @onchange="e => UpdateRecordStatusAsync(item, e)">
            <option value="@AttendanceStatus.Present" selected="@(item.Status == AttendanceStatus.Present)">正常</option>
            <option value="@AttendanceStatus.Late" selected="@(item.Status == AttendanceStatus.Late)">迟到</option>
            <option value="@AttendanceStatus.Absent" selected="@(item.Status == AttendanceStatus.Absent)">缺勤</option>
            <option value="@AttendanceStatus.Leave" selected="@(item.Status == AttendanceStatus.Leave)">请假</option>
        </select>
    </span>;

    /// <summary>加载会话详情与签到记录</summary>
    private async Task LoadSessionAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            _session = await ApiClient.GetAsync<SessionResponseDto>($"api/sessions/{SessionId}");
            await LoadRecordsAsync();
            // 若会话进行中且已有 token，自动生成二维码
            if (_session is not null && _session.Status == SessionStatus.Active)
            {
                await GenerateQrCodeAsync();
            }
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "加载会话失败，请稍后重试";
            Logger.LogError(ex, "加载考勤会话异常");
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>加载签到记录</summary>
    private async Task LoadRecordsAsync()
    {
        try
        {
            _records = await ApiClient.GetAsync<List<AttendanceRecordResponseDto>>($"api/sessions/{SessionId}/records");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载签到记录失败");
        }
    }

    /// <summary>创建考勤会话</summary>
    private async Task CreateSessionAsync()
    {
        if (_newCourseId <= 0 || _newClassId <= 0)
        {
            _errorMessage = "课程或班级参数无效";
            return;
        }

        _operating = true;
        _errorMessage = null;
        try
        {
            var dto = new SessionCreateDto
            {
                CourseId = _newCourseId,
                ClassId = _newClassId,
                ScheduleId = _newScheduleId,
                StartTime = DateTime.UtcNow,
                EndTime = DateTime.UtcNow.AddMinutes(_durationMinutes)
            };
            var created = await ApiClient.PostAsync<SessionResponseDto>("api/sessions", dto);
            if (created is not null)
            {
                // 跳转到会话详情页
                NavigationManager.NavigateTo($"/teacher/session/{created.Id}");
            }
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "创建会话失败，请稍后重试";
            Logger.LogError(ex, "创建考勤会话异常");
        }
        finally
        {
            _operating = false;
        }
    }

    /// <summary>生成二维码</summary>
    private async Task GenerateQrCodeAsync()
    {
        if (_session is null) return;
        _operating = true;
        _errorMessage = null;
        try
        {
            _qrCode = await ApiClient.PostAsync<QrCodeResult>($"api/sessions/{_session.Id}/qrcode", null);
            if (_qrCode is not null)
            {
                _countdown = _qrCode.ExpireSeconds;
            }
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "生成二维码失败，请稍后重试";
            Logger.LogError(ex, "生成二维码异常");
        }
        finally
        {
            _operating = false;
        }
    }

    /// <summary>刷新二维码</summary>
    private async Task RefreshQrCodeAsync()
    {
        await GenerateQrCodeAsync();
    }

    /// <summary>一键点名：将未签到学生标记为缺勤</summary>
    private async Task RollCallAllAsync()
    {
        if (_session is null) return;
        _operating = true;
        _errorMessage = null;
        try
        {
            await ApiClient.PostAsync<object>($"api/sessions/{_session.Id}/roll-call-all", null);
            _successMessage = "一键点名完成";
            await LoadRecordsAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "一键点名失败，请稍后重试";
            Logger.LogError(ex, "一键点名异常");
        }
        finally
        {
            _operating = false;
        }
    }

    /// <summary>修改单条记录状态</summary>
    private async Task UpdateRecordStatusAsync(AttendanceRecordResponseDto record, ChangeEventArgs e)
    {
        if (!Enum.TryParse<AttendanceStatus>(e.Value?.ToString(), out var newStatus)) return;

        _operating = true;
        _errorMessage = null;
        try
        {
            var dto = new UpdateRecordStatusDto { Status = newStatus };
            await ApiClient.PutAsync<object>($"api/sessions/records/{record.Id}", dto);
            await LoadRecordsAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "修改状态失败，请稍后重试";
            Logger.LogError(ex, "修改考勤记录状态异常");
        }
        finally
        {
            _operating = false;
        }
    }

    /// <summary>关闭会话</summary>
    private async Task CloseSessionAsync()
    {
        if (_session is null) return;
        _operating = true;
        _errorMessage = null;
        try
        {
            await ApiClient.PostAsync<object>($"api/sessions/{_session.Id}/close", null);
            _successMessage = "会话已关闭";
            await LoadSessionAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "关闭会话失败，请稍后重试";
            Logger.LogError(ex, "关闭考勤会话异常");
        }
        finally
        {
            _operating = false;
        }
    }

    /// <summary>导出考勤记录为 Excel</summary>
    private async Task ExportRecordsAsync()
    {
        if (_session is null) return;
        _exporting = true;
        _errorMessage = null;
        try
        {
            var bytes = await ApiClient.DownloadFileAsync($"api/statistics/export/session/{_session.Id}");
            var fileName = $"考勤记录_{_session.CourseName}_{_session.Id}.xlsx";
            await DownloadFileAsync(bytes, fileName);
            _successMessage = "导出成功";
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "导出失败，请稍后重试";
            Logger.LogError(ex, "导出考勤记录异常");
        }
        finally
        {
            _exporting = false;
        }
    }

    /// <summary>跳转到手动补签（RollCall 页面）</summary>
    private void GoToManualCheckIn()
    {
        if (_session is null) return;
        NavigationManager.NavigateTo($"/teacher/rollcall/{_session.Id}");
    }

    /// <summary>跳转到随机点名</summary>
    private void GoToRollCall(long sessionId)
    {
        NavigationManager.NavigateTo($"/teacher/rollcall/{sessionId}");
    }

    /// <summary>返回上一页</summary>
    private void GoBack()
    {
        NavigationManager.NavigateTo("/teacher/dashboard");
    }

    /// <summary>通过 JS 触发浏览器下载文件</summary>
    private async Task DownloadFileAsync(byte[] bytes, string fileName)
    {
        var base64 = Convert.ToBase64String(bytes);
        await JSRuntime.InvokeVoidAsync("eval", $"var a=document.createElement('a');a.href='data:application/octet-stream;base64,{base64}';a.download='{fileName}';a.click();");
    }
}
