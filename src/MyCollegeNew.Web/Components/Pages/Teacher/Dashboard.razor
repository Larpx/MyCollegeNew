@page "/teacher/dashboard"
@layout TeacherLayout
@attribute [Authorize]
@rendermode InteractiveServer
@using Larpx.PersonalTools.MyCollegeNew.Shared.Enums
@using Larpx.PersonalTools.MyCollegeNew.Shared.Features.Attendance
@using Larpx.PersonalTools.MyCollegeNew.Shared.Features.Courses
@using Larpx.PersonalTools.MyCollegeNew.Shared.Features.Statistics
@using Larpx.PersonalTools.MyCollegeNew.Shared.Features.Users
@inject IApiClient ApiClient
@inject TokenService TokenService
@inject NavigationManager NavigationManager
@inject ILogger<Components.Pages.Teacher.Dashboard> Logger

<PageTitle>教师仪表盘 - 考勤管理系统</PageTitle>

<PageHeader Title="教师仪表盘" Icon="layout-dashboard" Subtitle="@($"欢迎回来，{_userName}")">
    <Actions>
        <Button Variant="ButtonVariant.Secondary" Icon="refresh-cw" OnClick="LoadDataAsync" Loading="_loading">刷新</Button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert--error">
        <span class="alert__icon"><Icon Name="alert-circle" Size="20" /></span>
        <span class="alert__body">@_errorMessage</span>
    </div>
}

@if (_loading && _statistics is null)
{
    <div class="loading-state">
        <span class="loading-state__spinner"></span>
        <span>加载中...</span>
    </div>
}
else
{
    @* 教师身份信息卡片：工号 / 姓名 / 系主任徽章 *@
    <Card Class="mb-6">
        <div class="dashboard-welcome">
            <span class="dashboard-welcome__avatar">
                <Icon Name="user" Size="28" />
            </span>
            <div class="dashboard-welcome__info">
                <div class="dashboard-welcome__name-row">
                    <span class="dashboard-welcome__name">@_userName</span>
                    @if (_isDepartmentHead)
                    {
                        <Badge Variant="BadgeVariant.Primary" Icon="award">系主任</Badge>
                    }
                    @if (_isCounselor)
                    {
                        <Badge Variant="BadgeVariant.Neutral">辅导员</Badge>
                    }
                    else
                    {
                        <Badge Variant="BadgeVariant.Success">任课教师</Badge>
                    }
                </div>
                <div class="dashboard-welcome__id">工号：@_userId</div>
            </div>
        </div>
    </Card>

    @* 待办提醒：系主任待审批接课申请（数量为 0 不显示） *@
    @if (_isDepartmentHead && _pendingAssignmentsCount > 0)
    {
        <Card Class="mb-6">
            <div class="todo-reminder">
                <div class="todo-reminder__left">
                    <span class="stat-card__icon stat-card__icon--warning"><Icon Name="inbox" Size="20" /></span>
                    <div>
                        <div class="todo-reminder__title">待审批接课申请</div>
                        <div class="todo-reminder__subtitle">系主任专属功能</div>
                    </div>
                </div>
                <div class="todo-reminder__right">
                    <span class="tab-bar__badge">@_pendingAssignmentsCount</span>
                    <Button Variant="ButtonVariant.Primary" Icon="inbox" OnClick="GoToAssignmentReview">前往审批</Button>
                </div>
            </div>
        </Card>
    }

    @* 待办提醒：任课教师待确认调换课申请（数量为 0 不显示） *@
    @if (_pendingSwapsCount > 0)
    {
        <Card Class="mb-6">
            <div class="todo-reminder">
                <div class="todo-reminder__left">
                    <span class="stat-card__icon stat-card__icon--warning"><Icon Name="shuffle" Size="20" /></span>
                    <div>
                        <div class="todo-reminder__title">待确认调换课申请</div>
                        @if (_pendingSwaps.Any(s => s.IsExpiringSoon))
                        {
                            <div class="todo-reminder__subtitle todo-reminder__subtitle--danger">
                                <Icon Name="alert-triangle" Size="16" />
                                <span>@_pendingSwaps.Count(s => s.IsExpiringSoon) 笔即将逾期，剩余 @_pendingSwaps.Where(s => s.IsExpiringSoon).Min(s => s.RemainingHours).ToString("F0") 小时</span>
                            </div>
                        }
                        else
                        {
                            <div class="todo-reminder__subtitle">有教师委托您代课的申请待处理</div>
                        }
                    </div>
                </div>
                <div class="todo-reminder__right">
                    <span class="tab-bar__badge">@_pendingSwapsCount</span>
                    <Button Variant="ButtonVariant.Primary" Icon="shuffle" OnClick="GoToSwaps">前往处理</Button>
                </div>
            </div>
        </Card>
    }

    @* 待办提醒：原任课教师发起的调换课即将逾期撤销（仅当存在即将逾期项时显示） *@
    @if (_expiringInitiatedSwapsCount > 0)
    {
        <Card Class="mb-6">
            <div class="todo-reminder">
                <div class="todo-reminder__left">
                    <span class="stat-card__icon stat-card__icon--warning"><Icon Name="alert-triangle" Size="20" /></span>
                    <div>
                        <div class="todo-reminder__title">代课人未响应，即将自动撤销</div>
                        <div class="todo-reminder__subtitle">您发起的 @_expiringInitiatedSwapsCount 笔调换课申请 48 小时内未确认将自动撤销</div>
                    </div>
                </div>
                <div class="todo-reminder__right">
                    <Button Variant="ButtonVariant.Secondary" Icon="shuffle" OnClick="GoToSwaps">查看详情</Button>
                </div>
            </div>
        </Card>
    }

    @* 统计卡片 *@
    <div class="dashboard-grid">
        <Card>
            <div class="stat-card">
                <span class="stat-card__icon"><Icon Name="book-open" Size="24" /></span>
                <div class="stat-card__body">
                    <div class="stat-card__label">我的课程</div>
                    <div class="stat-card__value">@(_statistics?.TotalCourses ?? 0)</div>
                </div>
            </div>
        </Card>
        <Card>
            <div class="stat-card">
                <span class="stat-card__icon stat-card__icon--success"><Icon Name="clipboard-list" Size="24" /></span>
                <div class="stat-card__body">
                    <div class="stat-card__label">考勤会话总数</div>
                    <div class="stat-card__value">@(_statistics?.TotalSessions ?? 0)</div>
                </div>
            </div>
        </Card>
        <Card>
            <div class="stat-card">
                <span class="stat-card__icon stat-card__icon--warning"><Icon Name="play" Size="24" /></span>
                <div class="stat-card__body">
                    <div class="stat-card__label">进行中会话</div>
                    <div class="stat-card__value">@(_activeSessions?.Count ?? 0)</div>
                </div>
            </div>
        </Card>
        <Card>
            <div class="stat-card">
                <span class="stat-card__icon stat-card__icon--success"><Icon Name="percent" Size="24" /></span>
                <div class="stat-card__body">
                    <div class="stat-card__label">平均出勤率</div>
                    <div class="stat-card__value">@((_statistics?.AverageAttendanceRate ?? 0).ToString("F1"))%</div>
                </div>
            </div>
        </Card>
    </div>

    @* 辅导员待审批请假徽章（仅辅导员可见） *@
    @if (_isCounselor)
    {
        <Card Class="mb-6">
            <div class="todo-reminder">
                <div class="todo-reminder__left">
                    <span class="stat-card__icon stat-card__icon--warning"><Icon Name="inbox" Size="20" /></span>
                    <div>
                        <div class="todo-reminder__title">待审批请假申请</div>
                        <div class="todo-reminder__subtitle">辅导员专属功能</div>
                    </div>
                </div>
                <div class="todo-reminder__right">
                    <span class="tab-bar__badge">@_pendingLeavesCount</span>
                    <Button Variant="ButtonVariant.Primary" Icon="clipboard-list" OnClick="GoToLeaves">前往审批</Button>
                </div>
            </div>
        </Card>
    }

    @* 进行中会话（如有） *@
    @if (_activeSessions is not null && _activeSessions.Count > 0)
    {
        <Card Title="进行中考勤会话" Class="mb-6">
            <div class="course-card-list">
                @foreach (var session in _activeSessions)
                {
                    <div class="course-card-item">
                        <span class="course-card-item__section"><Icon Name="play" Size="20" /></span>
                        <div class="course-card-item__body">
                            <div class="course-card-item__title">@session.CourseName</div>
                            <div class="course-card-item__meta">
                                <span class="course-card-item__meta-item"><Icon Name="users" Size="16" />@session.ClassName</span>
                                <span class="course-card-item__meta-item"><Icon Name="clock" Size="16" />@session.StartTime.ToLocalTime().ToString("HH:mm")</span>
                            </div>
                        </div>
                        <div class="course-card-item__actions">
                            <Button Variant="ButtonVariant.Primary" Icon="qr-code" OnClick="() => GoToSession(session.Id)">查看签到</Button>
                        </div>
                    </div>
                }
            </div>
        </Card>
    }

    @* 今日课程：每项支持 发起考勤 + 调换课 两个操作 *@
    <Card Title="今日课程">
        @if (_todaySchedules is null || _todaySchedules.Count == 0)
        {
            <EmptyState Title="今日无课" Description="今天没有排课记录" Icon="calendar-days" />
        }
        else
        {
            <div class="course-card-list">
                @foreach (var schedule in _todaySchedules)
                {
                    <div class="course-card-item">
                        <span class="course-card-item__section">第@(schedule.StartSection)-@(schedule.EndSection)节</span>
                        <div class="course-card-item__body">
                            <div class="course-card-item__title">@schedule.CourseName</div>
                            <div class="course-card-item__meta">
                                <span class="course-card-item__meta-item"><Icon Name="users" Size="16" />@schedule.ClassName</span>
                                <span class="course-card-item__meta-item"><Icon Name="map-pin" Size="16" />@schedule.Classroom</span>
                            </div>
                        </div>
                        <div class="course-card-item__actions">
                            <Button Variant="ButtonVariant.Primary" Icon="qr-code" OnClick="() => StartSessionAsync(schedule)">发起考勤</Button>
                            <Button Variant="ButtonVariant.Secondary" Icon="shuffle" OnClick="() => GoToSwapCreate(schedule)">调换课</Button>
                        </div>
                    </div>
                }
            </div>
        }
    </Card>
}

@code {
    private TeacherStatisticsDto? _statistics;
    private List<SessionResponseDto>? _activeSessions;
    private List<ScheduleResponseDto>? _todaySchedules;
    private int _pendingLeavesCount;
    private int _pendingAssignmentsCount;
    private int _pendingSwapsCount;
    private List<SwapRequestResponseDto> _pendingSwaps = new();
    private int _expiringInitiatedSwapsCount;
    private bool _loading;
    private string? _errorMessage;
    private string _userId = string.Empty;
    private string _userName = string.Empty;
    private bool _isCounselor;
    private bool _isDepartmentHead;

    /// <summary>页面初始化：获取用户信息并加载数据</summary>
    protected override async Task OnInitializedAsync()
    {
        var userInfo = TokenService.GetUserInfo();
        if (userInfo is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        _userId = userInfo.UserId;
        _userName = userInfo.UserName;
        _isCounselor = userInfo.Role == "Counselor";
        await LoadDataAsync();
    }

    /// <summary>
    /// 并行加载教师统计、进行中会话、今日课表，并同步加载系主任身份与待办数；
    /// 主流程失败抛错，辅助流程失败静默降级以保证仪表盘可用
    /// </summary>
    private async Task LoadDataAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            // 计算今日星期几（1=周一, 7=周日）
            var today = DateTime.UtcNow;
            var dayOfWeek = (int)today.DayOfWeek;
            if (dayOfWeek == 0) dayOfWeek = 7; // 周日转为 7

            // 主流程：统计、进行中会话、今日课表
            var statsTask = ApiClient.GetAsync<TeacherStatisticsDto>($"statistics/teacher/{_userId}");
            var activeTask = ApiClient.GetAsync<List<SessionResponseDto>>("sessions/active");
            var scheduleTask = ApiClient.GetAsync<WeeklyScheduleDto>($"schedules/weekly/teacher/{_userId}?week=1");

            // 辅助流程：教师身份（含系主任标记位）、待确认调换课申请、本人发起的调换课申请（用于 SLA 即将逾期提醒）；失败不影响主流程
            var teacherInfoTask = SafeGetAsync<TeacherResponseDto>("teachers/me");
            var swapsTask = SafeGetAsync<List<SwapRequestResponseDto>>("courses/swaps?role=substitute");
            var initiatedSwapsTask = SafeGetAsync<List<SwapRequestResponseDto>>("courses/swaps?role=initiator");

            await Task.WhenAll(statsTask, activeTask, scheduleTask, teacherInfoTask, swapsTask, initiatedSwapsTask);

            _statistics = statsTask.Result;
            _activeSessions = activeTask.Result;
            var weekly = scheduleTask.Result;
            _todaySchedules = weekly?.Days?.GetValueOrDefault(dayOfWeek) ?? new List<ScheduleResponseDto>();

            // 解析系主任身份与待确认调换课数（任课教师可见）
            _isDepartmentHead = teacherInfoTask.Result?.IsDepartmentHead ?? false;
            _pendingSwaps = swapsTask.Result ?? new();
            _pendingSwapsCount = _pendingSwaps.Count;
            // 原任课教师发起的调换课中即将逾期未确认的数量（IsExpiringSoon 由后端依据 SLA 计算）
            _expiringInitiatedSwapsCount = (initiatedSwapsTask.Result ?? new()).Count(s => s.IsExpiringSoon);

            // 系主任额外加载待审批接课申请数（仅系主任有权限）
            if (_isDepartmentHead)
            {
                var pendingAssignments = await SafeGetAsync<List<AssignmentResponseDto>>("courses/assignments/pending");
                _pendingAssignmentsCount = pendingAssignments?.Count ?? 0;
            }

            // 辅导员额外加载待审批请假数
            if (_isCounselor)
            {
                var pendingObj = await SafeGetAsync<Dictionary<string, int>>("leaves/pending-count");
                if (pendingObj is not null && pendingObj.TryGetValue("Count", out var count))
                {
                    _pendingLeavesCount = count;
                }
            }
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
            Logger.LogWarning(ex, "加载教师仪表盘数据失败");
        }
        catch (Exception ex)
        {
            _errorMessage = "加载数据失败，请稍后重试";
            Logger.LogError(ex, "加载教师仪表盘数据异常");
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// 安全 GET 请求包装：捕获异常并返回默认值，避免辅助查询失败导致主仪表盘无法渲染
    /// </summary>
    /// <typeparam name="T">返回数据类型</typeparam>
    /// <param name="url">相对地址</param>
    /// <returns>业务数据；失败返回 default</returns>
    private async Task<T?> SafeGetAsync<T>(string url)
    {
        try
        {
            return await ApiClient.GetAsync<T>(url);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载 {Url} 失败，已忽略", url);
            return default;
        }
    }

    /// <summary>开始考勤：跳转到会话页（先创建会话）</summary>
    private Task StartSessionAsync(ScheduleResponseDto schedule)
    {
        // 通过查询参数传递排课信息，由 Session 页面创建会话
        NavigationManager.NavigateTo($"/teacher/session/new?courseId={schedule.CourseId}&classId={schedule.ClassId}&scheduleId={schedule.Id}");
        return Task.CompletedTask;
    }

    /// <summary>跳转到调换课发起页（新增页面由另一 subagent 实现）</summary>
    private void GoToSwapCreate(ScheduleResponseDto schedule)
    {
        NavigationManager.NavigateTo($"/teacher/swaps/new?scheduleId={schedule.Id}");
    }

    /// <summary>跳转到会话详情</summary>
    private void GoToSession(long sessionId)
    {
        NavigationManager.NavigateTo($"/teacher/session/{sessionId}");
    }

    /// <summary>跳转到请假审批页</summary>
    private void GoToLeaves()
    {
        NavigationManager.NavigateTo("/teacher/leaves");
    }

    /// <summary>跳转到接课审批页（系主任专属）</summary>
    private void GoToAssignmentReview()
    {
        NavigationManager.NavigateTo("/teacher/assignments/review");
    }

    /// <summary>跳转到调换课申请列表页</summary>
    private void GoToSwaps()
    {
        NavigationManager.NavigateTo("/teacher/swaps");
    }
}
