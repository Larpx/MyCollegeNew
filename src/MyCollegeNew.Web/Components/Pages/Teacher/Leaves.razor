@page "/teacher/leaves"
@layout TeacherLayout
@attribute [Authorize(Roles = "Counselor")]
@rendermode InteractiveServer
@using Larpx.PersonalTools.MyCollegeNew.Shared.Enums
@using Larpx.PersonalTools.MyCollegeNew.Shared.Features.Leave
@inject IApiClient ApiClient
@inject ILogger<Components.Pages.Teacher.Leaves> Logger

<PageTitle>请假审批 - 考勤管理系统</PageTitle>

<PageHeader Title="请假审批" Icon="inbox" Subtitle="辅导员专属：审批学生请假申请">
    <Actions>
        <Button Variant="ButtonVariant.Secondary" Icon="refresh-cw" OnClick="LoadLeavesAsync" Loading="_loading">刷新</Button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert--error">
        <span class="alert__icon"><Icon Name="alert-circle" Size="20" /></span>
        <span class="alert__body">@_errorMessage</span>
    </div>
}

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert--success">
        <span class="alert__icon"><Icon Name="check-circle" Size="20" /></span>
        <span class="alert__body">@_successMessage</span>
    </div>
}

@* 状态过滤 *@
<div class="page-filters">
    <div class="page-filters__field">
        <label class="page-filters__label">审批状态</label>
        <select class="page-filters__select" @bind="_filterStatus">
            <option value="">全部</option>
            <option value="@LeaveStatus.Pending">待审批</option>
            <option value="@LeaveStatus.Approved">已通过</option>
            <option value="@LeaveStatus.Rejected">已驳回</option>
        </select>
    </div>
    <div class="page-filters__actions">
        <Button Variant="ButtonVariant.Secondary" Icon="search" OnClick="SearchAsync">查询</Button>
    </div>
</div>

@* 请假记录列表 *@
@if (_loading && _leaves is null)
{
    <div class="loading-state">
        <span class="loading-state__spinner"></span>
        <span>加载中...</span>
    </div>
}
else
{
    <Card>
        <Table T="LeaveResponseDto"
               Items="_leaves?.Items"
               Columns="_columns"
               ShowPagination="true"
               PageIndex="_pageIndex"
               PageSize="_pageSize"
               TotalCount="(int)(_leaves?.Total ?? 0)"
               PageChanged="OnPageChanged" />
    </Card>
}

@* 审批 Modal *@
<Modal Visible="_reviewModalVisible" Title="@_reviewModalTitle" OnClose="CloseReviewModal">
    <ChildContent>
        @if (_reviewingLeave is not null)
        {
            <div class="info-list">
                <div class="info-list__item">
                    <span class="info-list__label">学生学号</span>
                    <span class="info-list__value">@_reviewingLeave.StudentId</span>
                </div>
                <div class="info-list__item">
                    <span class="info-list__label">学生姓名</span>
                    <span class="info-list__value">@_reviewingLeave.StudentName</span>
                </div>
                <div class="info-list__item">
                    <span class="info-list__label">请假类型</span>
                    <span class="info-list__value">@GetLeaveTypeName(_reviewingLeave.LeaveType)</span>
                </div>
                <div class="info-list__item">
                    <span class="info-list__label">开始时间</span>
                    <span class="info-list__value">@_reviewingLeave.StartTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                </div>
                <div class="info-list__item">
                    <span class="info-list__label">结束时间</span>
                    <span class="info-list__value">@_reviewingLeave.EndTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                </div>
                <div class="info-list__item">
                    <span class="info-list__label">请假事由</span>
                    <span class="info-list__value">@_reviewingLeave.Reason</span>
                </div>
                <div class="info-list__item">
                    <span class="info-list__label">提交时间</span>
                    <span class="info-list__value">@_reviewingLeave.CreateTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                </div>
            </div>
            <div class="form-field mt-4">
                <label class="form-field__label">审批备注</label>
                <input class="form-field__input" @bind="_reviewRemark" placeholder="审批备注（可选）" maxlength="256" />
            </div>
        }
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseReviewModal">取消</Button>
        <Button Variant="ButtonVariant.Outline" Icon="x" OnClick="() => RejectAsync()" Loading="_operating">驳回</Button>
        <Button Variant="ButtonVariant.Primary" Icon="check" OnClick="() => ApproveAsync()" Loading="_operating">通过</Button>
    </Footer>
</Modal>

@code {
    private PagedResult<LeaveResponseDto>? _leaves;
    private int _pageIndex = 1;
    private int _pageSize = 10;
    private LeaveStatus? _filterStatus;
    private bool _loading;
    private bool _operating;
    private string? _errorMessage;
    private string? _successMessage;

    // 审批 Modal 状态
    private bool _reviewModalVisible;
    private string _reviewModalTitle = string.Empty;
    private LeaveResponseDto? _reviewingLeave;
    private string? _reviewRemark;

    private List<Table<LeaveResponseDto>.Column<LeaveResponseDto>> _columns = new();

    /// <summary>页面初始化</summary>
    protected override async Task OnInitializedAsync()
    {
        BuildColumns();
        await LoadLeavesAsync();
    }

    /// <summary>构建表格列</summary>
    private void BuildColumns()
    {
        _columns = new List<Table<LeaveResponseDto>.Column<LeaveResponseDto>>
        {
            new() { Title = "学号", Template = item => @<span class="font-medium">@item.StudentId</span> },
            new() { Title = "姓名", Template = item => @<span>@item.StudentName</span> },
            new() { Title = "类型", Template = item => @<span>@GetLeaveTypeName(item.LeaveType)</span> },
            new() { Title = "时间范围", Template = item => @<span class="text-sm">@item.StartTime.ToLocalTime().ToString("MM-dd HH:mm") ~ @item.EndTime.ToLocalTime().ToString("MM-dd HH:mm")</span> },
            new() { Title = "状态", Template = item => RenderStatusBadge(item.Status) },
            new() { Title = "操作", Template = item => RenderActions(item) }
        };
    }

    /// <summary>获取请假类型名称</summary>
    private static string GetLeaveTypeName(LeaveType type) => type switch
    {
        LeaveType.Sick => "病假",
        LeaveType.Personal => "事假",
        LeaveType.Official => "公假",
        LeaveType.Other => "其他",
        _ => "未知"
    };

    /// <summary>渲染审批状态徽章</summary>
    private RenderFragment RenderStatusBadge(LeaveStatus status)
    {
        var (text, variant) = status switch
        {
            LeaveStatus.Pending => ("待审批", BadgeVariant.Warning),
            LeaveStatus.Approved => ("已通过", BadgeVariant.Success),
            LeaveStatus.Rejected => ("已驳回", BadgeVariant.Error),
            _ => ("未知", BadgeVariant.Neutral)
        };
        return @<Badge Variant="variant">@text</Badge>;
    }

    /// <summary>渲染行操作按钮</summary>
    private RenderFragment RenderActions(LeaveResponseDto item) => @<span class="table-actions">
        @if (item.Status == LeaveStatus.Pending)
        {
            <button type="button" class="table-action-btn" @onclick="() => OpenReviewModal(item)" title="审批" aria-label="审批">
                <Icon Name="check-square" Size="16" />
            </button>
        }
        else
        {
            <button type="button" class="table-action-btn" @onclick="() => OpenReviewModal(item)" title="查看详情" aria-label="查看详情">
                <Icon Name="eye" Size="16" />
            </button>
        }
    </span>;

    /// <summary>加载请假记录</summary>
    private async Task LoadLeavesAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            var url = $"leaves/counselor?pageIndex={_pageIndex}&pageSize={_pageSize}";
            if (_filterStatus.HasValue) url += $"&status={_filterStatus.Value}";
            _leaves = await ApiClient.GetAsync<PagedResult<LeaveResponseDto>>(url);
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "加载请假记录失败，请稍后重试";
            Logger.LogError(ex, "加载请假记录异常");
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>查询按钮：重置页码后加载</summary>
    private async Task SearchAsync()
    {
        _pageIndex = 1;
        await LoadLeavesAsync();
    }

    /// <summary>分页变更</summary>
    private async Task OnPageChanged(int newPage)
    {
        _pageIndex = newPage;
        await LoadLeavesAsync();
    }

    /// <summary>打开审批 Modal</summary>
    private void OpenReviewModal(LeaveResponseDto leave)
    {
        _reviewingLeave = leave;
        _reviewModalTitle = leave.Status == LeaveStatus.Pending ? "审批请假申请" : "请假详情";
        _reviewRemark = string.Empty;
        _reviewModalVisible = true;
    }

    /// <summary>关闭审批 Modal</summary>
    private void CloseReviewModal()
    {
        _reviewModalVisible = false;
        _reviewingLeave = null;
        _reviewRemark = null;
    }

    /// <summary>审批通过</summary>
    private async Task ApproveAsync()
    {
        if (_reviewingLeave is null) return;
        _operating = true;
        _errorMessage = null;
        try
        {
            var dto = new LeaveReviewDto { ReviewRemark = _reviewRemark };
            await ApiClient.PostAsync<LeaveResponseDto>($"leaves/{_reviewingLeave.Id}/approve", dto);
            _successMessage = "审批通过";
            _reviewModalVisible = false;
            await LoadLeavesAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "审批失败，请稍后重试";
            Logger.LogError(ex, "审批通过异常");
        }
        finally
        {
            _operating = false;
        }
    }

    /// <summary>审批驳回</summary>
    private async Task RejectAsync()
    {
        if (_reviewingLeave is null) return;
        _operating = true;
        _errorMessage = null;
        try
        {
            var dto = new LeaveReviewDto { ReviewRemark = _reviewRemark };
            await ApiClient.PostAsync<LeaveResponseDto>($"leaves/{_reviewingLeave.Id}/reject", dto);
            _successMessage = "已驳回";
            _reviewModalVisible = false;
            await LoadLeavesAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "驳回失败，请稍后重试";
            Logger.LogError(ex, "审批驳回异常");
        }
        finally
        {
            _operating = false;
        }
    }
}
