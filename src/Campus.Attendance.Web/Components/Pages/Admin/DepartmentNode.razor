@using Campus.Attendance.Shared.Features.Organization
@* 院系树节点组件：递归渲染院系→专业→班级三级结构 *@
<div class="tree-node">
    @* 院系节点 *@
    <div class="tree-node__header">
        <button type="button"
                class="tree-node__toggle @(_deptExpanded ? "tree-node__toggle--expanded" : "")"
                @onclick="ToggleDept"
                aria-label="展开/折叠院系">
            <Icon Name="chevron-right" Size="16" />
        </button>
        <Icon Name="building" Size="16" />
        <span class="tree-node__title">@DeptNode.Department.Name</span>
        <span class="tree-node__meta">@DeptNode.Department.StudentCount 人</span>
        <span class="tree-node__actions">
            <button type="button" class="table-action-btn" @onclick="() => OnAddMajor.InvokeAsync(DeptNode.Department)" title="新增专业" aria-label="新增专业">
                <Icon Name="plus" Size="16" />
            </button>
            <button type="button" class="table-action-btn" @onclick="() => OnEditDepartment.InvokeAsync(DeptNode.Department)" title="编辑院系" aria-label="编辑院系">
                <Icon Name="edit" Size="16" />
            </button>
            <button type="button" class="table-action-btn table-action-btn--danger" @onclick="() => OnDeleteDepartment.InvokeAsync(DeptNode.Department)" title="删除院系" aria-label="删除院系">
                <Icon Name="trash" Size="16" />
            </button>
        </span>
    </div>

    @if (_deptExpanded)
    {
        <div class="tree-node__children">
            @foreach (var majorNode in DeptNode.Majors)
            {
                <MajorNode Node="majorNode"
                           OnEditMajor="OnEditMajor"
                           OnDeleteMajor="OnDeleteMajor"
                           OnAddClass="OnAddClass"
                           OnEditClass="OnEditClass"
                           OnDeleteClass="OnDeleteClass" />
            }
            @if (DeptNode.Majors.Count == 0)
            {
                <div class="text-tertiary text-xs" style="padding: var(--space-1) var(--space-2);">暂无专业，点击 + 新增</div>
            }
        </div>
    }
</div>

@code {
    /// <summary>院系树节点数据</summary>
    [Parameter]
    [EditorRequired]
    public OrganizationTreeNodeDto DeptNode { get; set; } = default!;

    /// <summary>编辑院系回调</summary>
    [Parameter] public EventCallback<DepartmentResponseDto> OnEditDepartment { get; set; }

    /// <summary>删除院系回调</summary>
    [Parameter] public EventCallback<DepartmentResponseDto> OnDeleteDepartment { get; set; }

    /// <summary>新增专业回调（传入所属院系）</summary>
    [Parameter] public EventCallback<DepartmentResponseDto> OnAddMajor { get; set; }

    /// <summary>编辑专业回调</summary>
    [Parameter] public EventCallback<MajorResponseDto> OnEditMajor { get; set; }

    /// <summary>删除专业回调</summary>
    [Parameter] public EventCallback<MajorResponseDto> OnDeleteMajor { get; set; }

    /// <summary>新增班级回调（传入所属专业）</summary>
    [Parameter] public EventCallback<MajorResponseDto> OnAddClass { get; set; }

    /// <summary>编辑班级回调</summary>
    [Parameter] public EventCallback<ClassResponseDto> OnEditClass { get; set; }

    /// <summary>删除班级回调</summary>
    [Parameter] public EventCallback<ClassResponseDto> OnDeleteClass { get; set; }

    private bool _deptExpanded = true;

    /// <summary>切换院系展开/折叠</summary>
    private void ToggleDept() => _deptExpanded = !_deptExpanded;
}
