@page "/admin/courses"
@layout AdminLayout
@attribute [Authorize]
@rendermode InteractiveServer
@using Campus.Attendance.Shared.Features.Courses
@using Campus.Attendance.Shared.Features.Users
@inject IApiClient ApiClient
@inject ILogger<Components.Pages.Admin.Courses> Logger

<PageTitle>课程管理 - 考勤管理系统</PageTitle>

<PageHeader Title="课程管理" Icon="book-open" Subtitle="管理课程信息与任课教师关联">
    <Actions>
        <Button Variant="ButtonVariant.Secondary" Icon="refresh-cw" OnClick="LoadCoursesAsync" Loading="_loading">刷新</Button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert--error">
        <span class="alert__icon"><Icon Name="alert-circle" Size="20" /></span>
        <span class="alert__body">@_errorMessage</span>
    </div>
}

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert--success">
        <span class="alert__icon"><Icon Name="check-circle" Size="20" /></span>
        <span class="alert__body">@_successMessage</span>
    </div>
}

@* 过滤器工具栏 *@
<div class="page-filters">
    <div class="page-filters__field">
        <label class="page-filters__label">关键字</label>
        <InputText @bind-Value="_keyword" placeholder="课程名称" class="form-field__input" />
    </div>
    <div class="page-filters__actions">
        <Button Variant="ButtonVariant.Secondary" Icon="search" OnClick="SearchAsync">查询</Button>
        <Button Variant="ButtonVariant.Primary" Icon="plus" OnClick="OpenCreateModal">新增课程</Button>
    </div>
</div>

@* 课程列表 *@
@if (_loading && _courses is null)
{
    <div class="loading-state">
        <span class="loading-state__spinner"></span>
        <span>加载中...</span>
    </div>
}
else
{
    <Card>
        <Table T="CourseResponseDto"
               Items="_courses?.Items"
               Columns="_columns"
               ShowPagination="true"
               PageIndex="_pageIndex"
               PageSize="_pageSize"
               TotalCount="(int)(_courses?.Total ?? 0)"
               PageChanged="OnPageChanged" />
    </Card>
}

@* 新增/编辑 Modal *@
<Modal Visible="_formModalVisible" Title="@_formModalTitle" OnClose="CloseFormModal">
    <ChildContent>
        <div class="form-grid">
            <div class="form-field form-field--full">
                <label class="form-field__label form-field__label--required">课程名称</label>
                <input class="form-field__input" @bind="_form.Name" placeholder="请输入课程名称" maxlength="64" />
            </div>
            <div class="form-field">
                <label class="form-field__label form-field__label--required">任课教师</label>
                <select class="form-field__input" @bind="_form.TeacherId">
                    <option value="">请选择</option>
                    @foreach (var teacher in _teachers)
                    {
                        <option value="@teacher.Id">@teacher.Name（@teacher.Id）</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label class="form-field__label form-field__label--required">学分</label>
                <input type="number" class="form-field__input" @bind="_form.Credit" placeholder="0.5-10" min="0.5" max="10" step="0.5" />
            </div>
            <div class="form-field form-field--full">
                <label class="form-field__label">备注</label>
                <input class="form-field__input" @bind="_form.Remark" placeholder="备注信息" maxlength="256" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseFormModal">取消</Button>
        <Button Variant="ButtonVariant.Primary" Icon="save" OnClick="SaveAsync" Loading="_saving">保存</Button>
    </Footer>
</Modal>

@* 删除确认 Modal *@
<Modal Visible="_deleteModalVisible" Title="删除确认" OnClose="CloseDeleteModal">
    <ChildContent>
        <div class="alert alert--warning">
            <span class="alert__icon"><Icon Name="alert-triangle" Size="20" /></span>
            <span class="alert__body">确定删除课程「@_deletingCourse?.Name」吗？关联的课表与考勤记录将保留但不再可用。</span>
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseDeleteModal">取消</Button>
        <Button Variant="ButtonVariant.Danger" Icon="trash" OnClick="ConfirmDeleteAsync" Loading="_saving">确认删除</Button>
    </Footer>
</Modal>

@code {
    private PagedResult<CourseResponseDto>? _courses;
    private List<TeacherResponseDto> _teachers = new();

    private int _pageIndex = 1;
    private int _pageSize = 10;
    private string _keyword = string.Empty;

    private bool _loading;
    private bool _saving;
    private string? _errorMessage;
    private string? _successMessage;

    // 表单状态
    private bool _formModalVisible;
    private string _formModalTitle = string.Empty;
    private bool _isEdit;
    private CourseForm _form = new();
    private long? _editingId;

    // 删除状态
    private bool _deleteModalVisible;
    private CourseResponseDto? _deletingCourse;

    private List<Table<CourseResponseDto>.Column<CourseResponseDto>> _columns = new();

    /// <summary>课程表单</summary>
    private sealed class CourseForm
    {
        public string Name { get; set; } = string.Empty;
        public string TeacherId { get; set; } = string.Empty;
        public decimal Credit { get; set; } = 2.0m;
        public string? Remark { get; set; }
    }

    /// <summary>页面初始化</summary>
    protected override async Task OnInitializedAsync()
    {
        BuildColumns();
        await LoadTeachersAsync();
        await LoadCoursesAsync();
    }

    /// <summary>构建表格列</summary>
    private void BuildColumns()
    {
        _columns = new List<Table<CourseResponseDto>.Column<CourseResponseDto>>
        {
            new() { Title = "课程名称", Template = item => @<span class="font-medium">@item.Name</span> },
            new() { Title = "任课教师", Template = item => @<span>@item.TeacherName</span> },
            new() { Title = "学分", Template = item => @<span>@item.Credit</span> },
            new() { Title = "备注", Template = item => @<span class="text-secondary">@(item.Remark ?? "—")</span> },
            new() { Title = "操作", Template = item => RenderActions(item) }
        };
    }

    /// <summary>渲染行操作按钮</summary>
    private RenderFragment RenderActions(CourseResponseDto item) => @<span class="table-actions">
        <button type="button" class="table-action-btn" @onclick="() => OpenEditModal(item)" title="编辑" aria-label="编辑">
            <Icon Name="edit" Size="16" />
        </button>
        <button type="button" class="table-action-btn table-action-btn--danger" @onclick="() => OpenDeleteModal(item)" title="删除" aria-label="删除">
            <Icon Name="trash" Size="16" />
        </button>
    </span>;

    /// <summary>加载教师列表（用于表单下拉）</summary>
    private async Task LoadTeachersAsync()
    {
        try
        {
            // 通过分页端点拉取较大数量教师供下拉选择
            var paged = await ApiClient.GetAsync<PagedResult<TeacherResponseDto>>("api/teachers?pageIndex=1&pageSize=200");
            _teachers = paged?.Items ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载教师列表失败");
        }
    }

    /// <summary>加载课程分页数据</summary>
    private async Task LoadCoursesAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            var url = $"api/courses?pageIndex={_pageIndex}&pageSize={_pageSize}";
            if (!string.IsNullOrWhiteSpace(_keyword)) url += $"&keyword={Uri.EscapeDataString(_keyword.Trim())}";
            _courses = await ApiClient.GetAsync<PagedResult<CourseResponseDto>>(url);
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "加载课程列表失败，请稍后重试";
            Logger.LogError(ex, "加载课程列表异常");
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>查询按钮：重置页码后加载</summary>
    private async Task SearchAsync()
    {
        _pageIndex = 1;
        await LoadCoursesAsync();
    }

    /// <summary>分页变更</summary>
    private async Task OnPageChanged(int newPage)
    {
        _pageIndex = newPage;
        await LoadCoursesAsync();
    }

    // ---------- 表单 ----------

    /// <summary>打开新增 Modal</summary>
    private void OpenCreateModal()
    {
        _isEdit = false;
        _editingId = null;
        _formModalTitle = "新增课程";
        _form = new CourseForm { Credit = 2.0m };
        _formModalVisible = true;
    }

    /// <summary>打开编辑 Modal</summary>
    private void OpenEditModal(CourseResponseDto course)
    {
        _isEdit = true;
        _editingId = course.Id;
        _formModalTitle = "编辑课程";
        _form = new CourseForm
        {
            Name = course.Name,
            TeacherId = course.TeacherId,
            Credit = course.Credit,
            Remark = course.Remark
        };
        _formModalVisible = true;
    }

    /// <summary>关闭表单 Modal</summary>
    private void CloseFormModal() => _formModalVisible = false;

    /// <summary>保存课程</summary>
    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _errorMessage = "课程名称不能为空";
            return;
        }
        if (string.IsNullOrWhiteSpace(_form.TeacherId))
        {
            _errorMessage = "请选择任课教师";
            return;
        }
        if (_form.Credit < 0.5m || _form.Credit > 10m)
        {
            _errorMessage = "学分范围 0.5-10";
            return;
        }

        _saving = true;
        _errorMessage = null;
        _successMessage = null;
        try
        {
            if (_isEdit && _editingId.HasValue)
            {
                var dto = new CourseUpdateDto
                {
                    Name = _form.Name.Trim(),
                    TeacherId = _form.TeacherId,
                    Credit = _form.Credit,
                    Remark = _form.Remark
                };
                await ApiClient.PutAsync<CourseResponseDto>($"api/courses/{_editingId.Value}", dto);
                _successMessage = "课程信息已更新";
            }
            else
            {
                var dto = new CourseCreateDto
                {
                    Name = _form.Name.Trim(),
                    TeacherId = _form.TeacherId,
                    Credit = _form.Credit,
                    Remark = _form.Remark
                };
                await ApiClient.PostAsync<CourseResponseDto>("api/courses", dto);
                _successMessage = "课程创建成功";
            }
            _formModalVisible = false;
            await LoadCoursesAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "保存课程失败，请稍后重试";
            Logger.LogError(ex, "保存课程异常");
        }
        finally
        {
            _saving = false;
        }
    }

    // ---------- 删除 ----------

    /// <summary>打开删除确认</summary>
    private void OpenDeleteModal(CourseResponseDto course)
    {
        _deletingCourse = course;
        _deleteModalVisible = true;
    }

    /// <summary>关闭删除确认</summary>
    private void CloseDeleteModal()
    {
        _deleteModalVisible = false;
        _deletingCourse = null;
    }

    /// <summary>确认删除</summary>
    private async Task ConfirmDeleteAsync()
    {
        if (_deletingCourse is null) return;
        _saving = true;
        _errorMessage = null;
        try
        {
            await ApiClient.DeleteAsync<object>($"api/courses/{_deletingCourse.Id}");
            _deleteModalVisible = false;
            _deletingCourse = null;
            _successMessage = "课程已删除";
            await LoadCoursesAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "删除失败，请稍后重试";
            Logger.LogError(ex, "删除课程异常");
        }
        finally
        {
            _saving = false;
        }
    }
}
