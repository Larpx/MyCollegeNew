@page "/admin/dashboard"
@layout AdminLayout
@attribute [Authorize]
@rendermode InteractiveServer
@using Campus.Attendance.Shared.Features.Statistics
@inject IApiClient ApiClient
@inject ILogger<Components.Pages.Admin.Dashboard> Logger

<PageTitle>管理员仪表盘 - 考勤管理系统</PageTitle>

<PageHeader Title="管理员仪表盘" Icon="layout-dashboard" Subtitle="系统全局概览">
    <Actions>
        <Button Variant="ButtonVariant.Secondary" Icon="refresh-cw" OnClick="LoadDataAsync" Loading="_loading">刷新</Button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert--error">
        <span class="alert__icon"><Icon Name="alert-circle" Size="20" /></span>
        <span class="alert__body">@_errorMessage</span>
    </div>
}

@if (_loading && _overview is null)
{
    <div class="loading-state">
        <span class="loading-state__spinner"></span>
        <span>加载中...</span>
    </div>
}
else
{
    @* 统计卡片 *@
    <div class="dashboard-grid">
        <Card>
            <div class="stat-card">
                <span class="stat-card__icon"><Icon Name="users" Size="24" /></span>
                <div class="stat-card__body">
                    <div class="stat-card__label">学生总数</div>
                    <div class="stat-card__value">@(_overview?.TotalStudents ?? 0)</div>
                    <div class="stat-card__hint">全校在册学生</div>
                </div>
            </div>
        </Card>
        <Card>
            <div class="stat-card">
                <span class="stat-card__icon stat-card__icon--success"><Icon Name="user" Size="24" /></span>
                <div class="stat-card__body">
                    <div class="stat-card__label">教师总数</div>
                    <div class="stat-card__value">@(_overview?.TotalTeachers ?? 0)</div>
                    <div class="stat-card__hint">含任课教师与辅导员</div>
                </div>
            </div>
        </Card>
        <Card>
            <div class="stat-card">
                <span class="stat-card__icon stat-card__icon--warning"><Icon Name="calendar" Size="24" /></span>
                <div class="stat-card__body">
                    <div class="stat-card__label">今日会话数</div>
                    <div class="stat-card__value">@(_overview?.TodaySessions ?? 0)</div>
                    <div class="stat-card__hint">今日发起的考勤会话</div>
                </div>
            </div>
        </Card>
        <Card>
            <div class="stat-card">
                <span class="stat-card__icon stat-card__icon--success"><Icon Name="percent" Size="24" /></span>
                <div class="stat-card__body">
                    <div class="stat-card__label">全校出勤率</div>
                    <div class="stat-card__value">@((_overview?.OverallAttendanceRate ?? 0).ToString("F1"))%</div>
                    <div class="stat-card__hint">今日：@((_overview?.TodayAttendanceRate ?? 0).ToString("F1"))%</div>
                </div>
            </div>
        </Card>
    </div>

    @* 出勤趋势图 *@
    <Card Title="近 14 天出勤趋势" Class="mb-6">
        <div class="chart-container">
            @if (_trend is null || _trend.Count == 0)
            {
                <EmptyState Title="暂无趋势数据" Description="近期没有考勤记录" Icon="bar-chart" />
            }
            else
            {
                <div class="chart">
                    @foreach (var item in _trend)
                    {
                        var heightPercent = Math.Max(2, item.AttendanceRate);
                        <div class="chart__item">
                            <div class="chart__bar-wrapper">
                                <div class="chart__bar" style="height: @(heightPercent)%;">
                                    <span class="chart__bar-value">@item.AttendanceRate.ToString("F0")%</span>
                                </div>
                            </div>
                            <span class="chart__label">@item.Date.ToString("MM-dd")</span>
                        </div>
                    }
                </div>
            }
        </div>
    </Card>

    @* 院系排名 *@
    <Card Title="院系出勤率排名">
        @if (_ranking is null || _ranking.Count == 0)
        {
            <EmptyState Title="暂无排名数据" Description="还没有院系考勤数据" Icon="bar-chart" />
        }
        else
        {
            <Table T="DepartmentRankingDto" Items="_ranking" Columns="_rankingColumns" />
        }
    </Card>
}

@code {
    private OverviewStatisticsDto? _overview;
    private List<DepartmentRankingDto>? _ranking;
    private List<AttendanceTrendDto>? _trend;
    private bool _loading;
    private string? _errorMessage;

    private List<Table<DepartmentRankingDto>.Column<DepartmentRankingDto>> _rankingColumns = new();

    /// <summary>
    /// 页面初始化：构建表格列定义并加载数据
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        BuildRankingColumns();
        await LoadDataAsync();
    }

    /// <summary>构建院系排名表格列</summary>
    private void BuildRankingColumns()
    {
        _rankingColumns = new List<Table<DepartmentRankingDto>.Column<DepartmentRankingDto>>
        {
            new() { Title = "排名", Template = item => @<span class="font-semibold">@item.Rank</span> },
            new() { Title = "院系名称", Template = item => @<span>@item.DepartmentName</span> },
            new() { Title = "学生数", Template = item => @<span>@item.StudentCount</span> },
            new() { Title = "出勤率", Template = item => RenderRateBadge(item) }
        };
    }

    /// <summary>渲染出勤率徽章：根据数值显示不同颜色</summary>
    private RenderFragment RenderRateBadge(DepartmentRankingDto item)
    {
        var variant = item.AttendanceRate >= 90 ? BadgeVariant.Success
            : item.AttendanceRate >= 75 ? BadgeVariant.Warning
            : BadgeVariant.Error;
        return @<Badge Variant="variant">@item.AttendanceRate.ToString("F1")%</Badge>;
    }

    /// <summary>并行加载统计数据、院系排名、出勤趋势</summary>
    private async Task LoadDataAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            var endDate = DateTime.UtcNow;
            var startDate = endDate.AddDays(-13);
            var trendUrl = $"api/statistics/attendance-trend?startDate={startDate:yyyy-MM-dd}&endDate={endDate:yyyy-MM-dd}";

            // 并行调用三个统计端点，减少总等待时间
            var overviewTask = ApiClient.GetAsync<OverviewStatisticsDto>("api/statistics/overview");
            var rankingTask = ApiClient.GetAsync<List<DepartmentRankingDto>>("api/statistics/department-ranking");
            var trendTask = ApiClient.GetAsync<List<AttendanceTrendDto>>(trendUrl);

            await Task.WhenAll(overviewTask, rankingTask, trendTask);

            _overview = overviewTask.Result;
            _ranking = rankingTask.Result;
            _trend = trendTask.Result;
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
            Logger.LogWarning(ex, "加载管理员仪表盘数据失败");
        }
        catch (Exception ex)
        {
            _errorMessage = "加载数据失败，请稍后重试";
            Logger.LogError(ex, "加载管理员仪表盘数据异常");
        }
        finally
        {
            _loading = false;
        }
    }
}
