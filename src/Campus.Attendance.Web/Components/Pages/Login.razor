@page "/login"
@layout LoginLayout
@using Campus.Attendance.Models.Auth
@inject IApiClient ApiClient
@inject TokenService TokenService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>登录 - 考勤管理系统</PageTitle>

<div class="login-card">
    <div class="login-card__header">
        <h2 class="login-card__title">欢迎登录</h2>
        <p class="login-card__subtitle">请输入您的账号信息</p>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="login-card__alert" role="alert">
            <Icon Name="alert-circle" Size="20" />
            <span>@_errorMessage</span>
        </div>
    }

    <EditForm Model="@_model" OnValidSubmit="HandleLogin" class="login-card__form">
        <DataAnnotationsValidator />

        <div class="login-card__field">
            <label class="login-card__label" for="username">用户ID</label>
            <InputText id="username"
                       class="login-card__input"
                       placeholder="学号 / 工号 / admin"
                       @bind-Value="_model.Username" />
            <ValidationMessage For="@(() => _model.Username)" class="login-card__error" />
        </div>

        <div class="login-card__field">
            <label class="login-card__label" for="password">密码</label>
            <div class="login-card__password-wrapper">
                <InputText id="password"
                           class="login-card__input"
                           type="@(_isPasswordVisible ? "text" : "password")"
                           placeholder="请输入密码"
                           @bind-Value="_model.Password" />
                <button type="button"
                        class="login-card__password-toggle"
                        @onclick="TogglePasswordVisibility"
                        aria-label="切换密码可见性">
                    <Icon Name="@(_isPasswordVisible ? "eye-off" : "eye")" Size="16" />
                </button>
            </div>
            <ValidationMessage For="@(() => _model.Password)" class="login-card__error" />
        </div>

        <button type="submit"
                class="login-card__submit"
                disabled="@_loading">
            @if (_loading)
            {
                <span class="login-card__spinner" aria-hidden="true"></span>
                <span>登录中…</span>
            }
            else
            {
                <Icon Name="log-in" Size="20" />
                <span>登录</span>
            }
        </button>
    </EditForm>
</div>

@code {
    private LoginRequest _model = new();
    private bool _loading;
    private bool _isPasswordVisible;
    private string? _errorMessage;

    /// <summary>切换密码可见性</summary>
    private void TogglePasswordVisibility()
    {
        _isPasswordVisible = !_isPasswordVisible;
    }

    /// <summary>
    /// 处理登录：调用后端登录接口，存储 Token，更新认证状态，根据角色重定向
    /// </summary>
    private async Task HandleLogin()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            var result = await ApiClient.PostAsync<LoginResult>("api/auth/login", _model);
            if (result is null || string.IsNullOrEmpty(result.Token))
            {
                // 不暴露具体原因，统一提示
                _errorMessage = "用户名或密码错误";
                return;
            }

            // 存储 Token 到 localStorage
            await TokenService.SetTokenAsync(result.Token);

            // 通知认证状态变更
            AuthStateProvider.NotifyUserLogin(new UserInfo(result.UserId, result.UserName, result.Role));

            // 根据角色重定向到对应首页
            var targetUrl = GetRedirectUrl(result.Role);
            NavigationManager.NavigateTo(targetUrl, forceLoad: true);
        }
        catch (ApiException)
        {
            // 不暴露后端具体错误，统一提示
            _errorMessage = "用户名或密码错误";
        }
        catch (Exception)
        {
            _errorMessage = "登录失败，请稍后重试";
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// 根据角色返回重定向地址
    /// </summary>
    /// <param name="role">角色</param>
    /// <returns>重定向地址</returns>
    private static string GetRedirectUrl(string role) => role switch
    {
        "Admin" => "/admin/dashboard",
        "Teacher" => "/teacher/dashboard",
        "Counselor" => "/teacher/dashboard",
        "Student" => "/student/home",
        _ => "/login"
    };
}
