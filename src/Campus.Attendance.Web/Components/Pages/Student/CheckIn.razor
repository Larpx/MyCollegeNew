@page "/student/checkin"
@layout StudentLayout
@attribute [Authorize(Roles = "Student")]
@rendermode InteractiveServer
@using System.IdentityModel.Tokens.Jwt
@using Campus.Attendance.Shared.Enums
@using Campus.Attendance.Shared.Features.Attendance
@inject IApiClient ApiClient
@inject TokenService TokenService
@inject NavigationManager NavigationManager
@inject ILogger<Components.Pages.Student.CheckIn> Logger

<PageTitle>快捷签到 - 考勤管理系统</PageTitle>

<PageHeader Title="快捷签到" Icon="qr-code" Subtitle="输入签到码完成考勤签到" />

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert--error">
        <span class="alert__icon"><Icon Name="alert-circle" Size="20" /></span>
        <span class="alert__body">@_errorMessage</span>
    </div>
}

<Card>
    <div class="student-form-field">
        <label class="student-form-field__label student-form-field__label--required">签到码</label>
        <input class="student-checkin-input"
               type="text"
               placeholder="请输入签到码"
               value="@_token"
               @oninput="OnTokenChanged"
               autocomplete="off"
               maxlength="512" />
        <span class="student-form-field__hint">请输入教师展示的二维码签到码</span>
    </div>

    <Button Variant="ButtonVariant.Primary"
            Icon="check-circle"
            OnClick="CheckInAsync"
            Loading="_submitting"
            Disabled="string.IsNullOrWhiteSpace(_token)"
            Class="student-btn-large">
        签到
    </Button>

    @* 签到结果反馈 *@
    @if (_checkInResult is not null)
    {
        var isSuccess = _checkInResult.Status == AttendanceStatus.Present || _checkInResult.Status == AttendanceStatus.Late;
        <div class="student-checkin-result @(isSuccess ? "student-checkin-result--success" : "student-checkin-result--error")">
            <span class="student-checkin-result__icon">
                <Icon Name="@(isSuccess ? "check-circle" : "x-circle")" Size="24" />
            </span>
            <div class="student-checkin-result__body">
                <div class="student-checkin-result__title">@(isSuccess ? "签到成功" : "签到失败")</div>
                <div class="student-checkin-result__meta">
                    @if (isSuccess)
                    {
                        <text>状态：@GetStatusName(_checkInResult.Status) | 签到时间：@_checkInResult.CheckInTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</text>
                    }
                    else
                    {
                        <text>@_checkInResult.Message</text>
                    }
                </div>
            </div>
        </div>
    }
</Card>

@code {
    private string _token = string.Empty;
    private bool _submitting;
    private string? _errorMessage;
    private CheckInResult? _checkInResult;
    private string _studentId = string.Empty;

    /// <summary>
    /// 页面初始化：获取当前学生学号
    /// </summary>
    protected override void OnInitialized()
    {
        var userInfo = TokenService.GetUserInfo();
        if (userInfo is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        _studentId = userInfo.UserId;
    }

    /// <summary>签到码输入变更</summary>
    private void OnTokenChanged(ChangeEventArgs e)
    {
        _token = e.Value?.ToString() ?? string.Empty;
        // 输入新签到码时清除上次结果
        _checkInResult = null;
        _errorMessage = null;
    }

    /// <summary>
    /// 执行签到：从签到码（JWT）中解析 sessionId，调用签到接口
    /// </summary>
    private async Task CheckInAsync()
    {
        if (string.IsNullOrWhiteSpace(_token))
        {
            _errorMessage = "请输入签到码";
            return;
        }

        _submitting = true;
        _errorMessage = null;
        _checkInResult = null;

        try
        {
            // 从 JWT token 中解析 sessionId（签到码即二维码中的 JWT）
            var sessionId = ExtractSessionIdFromToken(_token);
            if (sessionId is null)
            {
                _errorMessage = "签到码格式无效，请检查后重新输入";
                return;
            }

            // 调用签到接口
            var request = new CheckInRequestDto { Token = _token };
            _checkInResult = await ApiClient.PostAsync<CheckInResult>($"api/sessions/{sessionId.Value}/checkin", request);
        }
        catch (ApiException ex)
        {
            _errorMessage = string.IsNullOrEmpty(ex.ApiMessage) ? "签到失败，请稍后重试" : ex.ApiMessage;
            Logger.LogWarning(ex, "学生签到失败");
        }
        catch (Exception ex)
        {
            _errorMessage = "签到失败，请稍后重试";
            Logger.LogError(ex, "学生签到异常");
        }
        finally
        {
            _submitting = false;
        }
    }

    /// <summary>
    /// 从 JWT 签到码中解析会话 ID
    /// 签到码 JWT 包含 session_id claim
    /// </summary>
    /// <param name="token">签到码（JWT）</param>
    /// <returns>会话 ID；解析失败返回 null</returns>
    private static long? ExtractSessionIdFromToken(string token)
    {
        try
        {
            var handler = new JwtSecurityTokenHandler();
            var jwt = handler.ReadJwtToken(token);
            var sessionIdClaim = jwt.Claims.FirstOrDefault(c => c.Type == "session_id");
            if (sessionIdClaim is not null && long.TryParse(sessionIdClaim.Value, out var sessionId))
            {
                return sessionId;
            }
            return null;
        }
        catch
        {
            return null;
        }
    }

    /// <summary>获取考勤状态中文名称</summary>
    private static string GetStatusName(AttendanceStatus status) => status switch
    {
        AttendanceStatus.Present => "正常",
        AttendanceStatus.Late => "迟到",
        AttendanceStatus.Absent => "缺勤",
        AttendanceStatus.Leave => "请假",
        _ => "未知"
    };
}
