@page "/teacher/courses"
@layout TeacherLayout
@attribute [Authorize]
@rendermode InteractiveServer
@using Campus.Attendance.Shared.Features.Courses
@using Campus.Attendance.Shared.Features.Organization
@inject IApiClient ApiClient
@inject TokenService TokenService
@inject NavigationManager NavigationManager
@inject ILogger<Components.Pages.Teacher.Courses> Logger

<PageTitle>我的课程 - 考勤管理系统</PageTitle>

<PageHeader Title="我的课程" Icon="book-open" Subtitle="查看任课课程与周课表">
    <Actions>
        <div class="tab-bar">
            <button type="button" class="@ListTabClass" @onclick='() => SwitchTab("list")'>
                <Icon Name="list" Size="16" />课程列表
            </button>
            <button type="button" class="@ScheduleTabClass" @onclick='() => SwitchTab("schedule")'>
                <Icon Name="calendar-days" Size="16" />周课表
            </button>
        </div>
    </Actions>
</PageHeader>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert--error">
        <span class="alert__icon"><Icon Name="alert-circle" Size="20" /></span>
        <span class="alert__body">@_errorMessage</span>
    </div>
}

@if (_loading)
{
    <div class="loading-state">
        <span class="loading-state__spinner"></span>
        <span>加载中...</span>
    </div>
}
else if (_activeTab == "list")
{
    @* 课程列表视图 *@
    @if (_courses is null || _courses.Count == 0)
    {
        <Card>
            <EmptyState Title="暂无课程" Description="您还没有任课课程" Icon="book-open" />
        </Card>
    }
    else
    {
        <Card Title="任课课程列表">
            <div class="course-card-list">
                @foreach (var course in _courses)
                {
                    <div class="course-card-item">
                        <span class="course-card-item__section"><Icon Name="book-open" Size="20" /></span>
                        <div class="course-card-item__body">
                            <div class="course-card-item__title">@course.Name</div>
                            <div class="course-card-item__meta">
                                <span class="course-card-item__meta-item"><Icon Name="hash" Size="16" />@(course.Credit) 学分</span>
                                @if (!string.IsNullOrEmpty(course.Remark))
                                {
                                    <span class="course-card-item__meta-item"><Icon Name="file-text" Size="16" />@course.Remark</span>
                                }
                            </div>
                        </div>
                        <div class="course-card-item__actions">
                            <Button Variant="ButtonVariant.Primary" Icon="qr-code" OnClick="() => StartSessionFromCourse(course)">发起考勤</Button>
                        </div>
                    </div>
                }
            </div>
        </Card>
    }
}
else if (_activeTab == "schedule")
{
    @* 周课表视图 *@
    <Card Title="周课表">
        <div class="page-filters">
            <div class="page-filters__field">
                <label class="page-filters__label">周次</label>
                <select class="page-filters__select" @bind="_week">
                    @for (int w = 1; w <= 20; w++)
                    {
                        <option value="@w">第 @w 周</option>
                    }
                </select>
            </div>
            <div class="page-filters__actions">
                <Button Variant="ButtonVariant.Secondary" Icon="search" OnClick="LoadScheduleAsync">查询</Button>
            </div>
        </div>

        @if (_weeklySchedule is null || _weeklySchedule.Days is null || _weeklySchedule.Days.Count == 0)
        {
            <EmptyState Title="本周无课" Description="@GetEmptyScheduleDescription()" Icon="calendar-days" />
        }
        else
        {
            <div class="schedule-grid">
                @for (int day = 1; day <= 7; day++)
                {
                    var daySchedules = _weeklySchedule.Days?.GetValueOrDefault(day) ?? new List<ScheduleResponseDto>();
                    var isToday = (int)DateTime.UtcNow.DayOfWeek == 0 ? 7 : (int)DateTime.UtcNow.DayOfWeek;
                    var dayHeaderClass = day == isToday ? "schedule-day__header schedule-day__header--today" : "schedule-day__header";
                    <div class="schedule-day">
                        <div class="@dayHeaderClass">
                            @GetDayName(day)
                        </div>
                        @foreach (var s in daySchedules)
                        {
                            <div class="schedule-item">
                                <div class="schedule-item__title">@s.CourseName</div>
                                <div class="schedule-item__meta">
                                    第@(s.StartSection)-@(s.EndSection)节<br />
                                    @s.ClassName<br />
                                    @s.Classroom
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </Card>
}

@* 发起考勤 Modal（选择班级） *@
<Modal Visible="_startModalVisible" Title="发起考勤" OnClose="CloseStartModal">
    <ChildContent>
        <div class="form-grid form-grid--single">
            <div class="alert alert--info">
                <span class="alert__icon"><Icon Name="info" Size="20" /></span>
                <span class="alert__body">课程：@_selectedCourse?.Name</span>
            </div>
            <div class="form-field">
                <label class="form-field__label form-field__label--required">选择班级</label>
                <select class="form-field__input" @bind="_selectedClassId">
                    <option value="0">请选择</option>
                    @foreach (var cls in _availableClasses)
                    {
                        <option value="@cls.Id">@cls.Name</option>
                    }
                </select>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseStartModal">取消</Button>
        <Button Variant="ButtonVariant.Primary" Icon="play" OnClick="ConfirmStartSession">开始考勤</Button>
    </Footer>
</Modal>

@code {
    private List<CourseResponseDto>? _courses;
    private WeeklyScheduleDto? _weeklySchedule;
    private List<ClassResponseDto> _availableClasses = new();

    private string _activeTab = "list";
    private int _week = 1;
    private bool _loading;
    private string? _errorMessage;
    private string _userId = string.Empty;

    // 发起考勤 Modal 状态
    private bool _startModalVisible;
    private CourseResponseDto? _selectedCourse;
    private long _selectedClassId;

    private static readonly string[] DayNames = { "", "周一", "周二", "周三", "周四", "周五", "周六", "周日" };

    /// <summary>页面初始化</summary>
    protected override async Task OnInitializedAsync()
    {
        var userInfo = TokenService.GetUserInfo();
        if (userInfo is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }
        _userId = userInfo.UserId;
        await LoadCoursesAsync();
    }

    /// <summary>获取星期名称</summary>
    private static string GetDayName(int day) => DayNames[day];

    /// <summary>获取标签页 CSS 类</summary>
    private string ListTabClass => _activeTab == "list" ? "tab-bar__item tab-bar__item--active" : "tab-bar__item";

    /// <summary>获取周课表标签页 CSS 类</summary>
    private string ScheduleTabClass => _activeTab == "schedule" ? "tab-bar__item tab-bar__item--active" : "tab-bar__item";

    /// <summary>获取空课表提示文案</summary>
    private string GetEmptyScheduleDescription() => $"第 {_week} 周没有排课记录";

    /// <summary>切换标签页</summary>
    private async Task SwitchTab(string tab)
    {
        _activeTab = tab;
        if (tab == "schedule" && _weeklySchedule is null)
        {
            await LoadScheduleAsync();
        }
    }

    /// <summary>加载我的课程列表</summary>
    private async Task LoadCoursesAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            _courses = await ApiClient.GetAsync<List<CourseResponseDto>>($"api/courses/by-teacher/{_userId}");
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "加载课程列表失败，请稍后重试";
            Logger.LogError(ex, "加载教师课程列表异常");
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>加载周课表</summary>
    private async Task LoadScheduleAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            _weeklySchedule = await ApiClient.GetAsync<WeeklyScheduleDto>($"api/schedules/by-teacher/{_userId}?week={_week}");
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.ApiMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = "加载课表失败，请稍后重试";
            Logger.LogError(ex, "加载周课表异常");
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>从课程发起考勤：打开班级选择 Modal</summary>
    private async Task StartSessionFromCourse(CourseResponseDto course)
    {
        _selectedCourse = course;
        _selectedClassId = 0;
        _availableClasses.Clear();
        try
        {
            // 通过教师课表查询该课程关联的班级（取第 1 周）
            var weekly = await ApiClient.GetAsync<WeeklyScheduleDto>($"api/schedules/by-teacher/{_userId}?week=1");
            if (weekly?.Days is not null)
            {
                // 从课表中提取该课程对应的所有班级（去重）
                var classDict = new Dictionary<long, ClassResponseDto>();
                foreach (var daySchedules in weekly.Days.Values)
                {
                    foreach (var s in daySchedules)
                    {
                        if (s.CourseId == course.Id && !classDict.ContainsKey(s.ClassId))
                        {
                            classDict[s.ClassId] = new ClassResponseDto
                            {
                                Id = s.ClassId,
                                Name = s.ClassName
                            };
                        }
                    }
                }
                _availableClasses = classDict.Values.ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载课程关联班级失败");
        }
        _startModalVisible = true;
    }

    /// <summary>关闭发起考勤 Modal</summary>
    private void CloseStartModal() => _startModalVisible = false;

    /// <summary>确认发起考勤：跳转到会话页</summary>
    private Task ConfirmStartSession()
    {
        if (_selectedCourse is null || _selectedClassId <= 0)
        {
            _errorMessage = "请选择班级";
            return Task.CompletedTask;
        }

        _startModalVisible = false;
        NavigationManager.NavigateTo($"/teacher/session/new?courseId={_selectedCourse.Id}&classId={_selectedClassId}");
        return Task.CompletedTask;
    }
}
