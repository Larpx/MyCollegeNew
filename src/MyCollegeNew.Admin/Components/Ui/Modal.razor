@* 模态对话框：毛玻璃遮罩 + 弹簧动画 *@
@if (IsOpen)
{
    <div class="ui-modal-overlay" @onclick="CloseOnOverlay">
        <div class="ui-modal @Class" @onclick:stopPropagation="true"
             style="max-width: @Width" role="dialog" aria-modal="true">
            @if (!string.IsNullOrEmpty(Title))
            {
                <div class="ui-modal__header">
                    <h3 class="ui-modal__title">@Title</h3>
                    <button type="button" class="ui-btn ui-btn--icon" @onclick="Close" aria-label="关闭">
                        <Icon Name="x" Size="20" />
                    </button>
                </div>
            }
            <div class="ui-modal__body">@ChildContent</div>
            @if (Footer is not null)
            {
                <div class="ui-modal__footer">@Footer</div>
            }
        </div>
    </div>
}

@code {
    /// <summary>是否显示</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>标题</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>最大宽度</summary>
    [Parameter] public string Width { get; set; } = "520px";

    /// <summary>点击遮罩是否关闭</summary>
    [Parameter] public bool CloseOnOverlayClick { get; set; } = true;

    /// <summary>关闭回调</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>底部内容（按钮等）</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>自定义 CSS 类</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>模态框内容</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task CloseOnOverlay()
    {
        if (CloseOnOverlayClick) await OnClose.InvokeAsync();
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
