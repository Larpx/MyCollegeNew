@page "/"
@inject NavigationManager NavigationManager
@inject TokenService TokenService

@* 根路径：已登录重定向到管理员仪表盘，未登录由 AuthorizeRouteView 跳转到登录页 *@
<PageTitle>跳转中...</PageTitle>

<div class="redirect-loading">
    <span class="redirect-loading__spinner" aria-hidden="true"></span>
    <span>正在跳转...</span>
</div>

@code {
    /// <summary>
    /// 已登录则跳转到管理员仪表盘，未登录则跳转到登录页
    /// </summary>
    protected override void OnInitialized()
    {
        var userInfo = TokenService.GetUserInfo();
        if (userInfo is not null)
        {
            NavigationManager.NavigateTo("/admin/dashboard", forceLoad: true);
        }
        else
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
    }
}
