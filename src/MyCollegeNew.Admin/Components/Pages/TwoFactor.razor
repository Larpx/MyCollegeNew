@page "/two-factor"
@layout LoginLayout
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@inject IDistributedCache DistributedCache
@inject ILogger<TwoFactor> Logger

<PageTitle>二次验证 - 考勤管理系统</PageTitle>

@{
    var httpContext = HttpContextAccessor.HttpContext;
    var tokenSet = httpContext is not null
        ? Antiforgery.GetAndStoreTokens(httpContext)
        : null;
    var requestToken = tokenSet?.RequestToken ?? string.Empty;
}

<div class="twofa-page">
    <div class="twofa-card">
        <div class="twofa-card__header">
            <div class="twofa-card__icon">
                <Icon Name="lock" Size="28" />
            </div>
            <h2 class="twofa-card__title">二次验证</h2>
            <p class="twofa-card__subtitle">
                @if (_hasSecret)
                {
                    <text>请打开验证器 App 查看验证码</text>
                }
                else
                {
                    <text>首次登录，请绑定验证器</text>
                }
            </p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert--error" role="alert">
                <Icon Name="alert-circle" Size="18" />
                <span>@_errorMessage</span>
            </div>
        }

        @* 未绑定用户且尚未加载二维码：显示获取二维码按钮 *@
        @if (!_hasSecret && !_setupLoaded)
        {
            <form method="post" action="/auth/2fa-setup" class="twofa-form">
                <input type="hidden" name="__RequestVerificationToken" value="@requestToken" />
                <input type="hidden" name="TwoFactorToken" value="@_twoFactorToken" />
                <p class="twofa-hint">
                    <Icon Name="info" Size="16" />
                    点击下方按钮获取验证器二维码
                </p>
                <button type="submit" class="twofa-submit-btn">
                    <Icon Name="qr-code" Size="18" />
                    获取二维码
                </button>
            </form>
        }

        @* 未绑定用户：显示二维码和绑定表单 *@
        @if (!_hasSecret && _setupLoaded)
        {
            <div class="twofa-setup">
                <div class="twofa-qr">
                    <img src="@_qrCodeBase64" alt="TOTP 二维码" class="twofa-qr__image" />
                </div>
                <p class="twofa-hint">
                    <Icon Name="info" Size="16" />
                    请使用 Google Authenticator / Microsoft Authenticator 扫描二维码
                </p>
                <div class="twofa-secret">
                    <span class="twofa-secret__label">手动输入密钥：</span>
                    <code class="twofa-secret__value">@_secret</code>
                </div>

                <form method="post" action="/auth/2fa-bind" class="twofa-form">
                    <input type="hidden" name="__RequestVerificationToken" value="@requestToken" />
                    <input type="hidden" name="TwoFactorToken" value="@_twoFactorToken" />
                    <input type="hidden" name="Secret" value="@_secret" />
                    <div class="twofa-input-group">
                        <input type="text"
                               name="Code"
                               class="twofa-code-input"
                               placeholder="输入 6 位验证码"
                               maxlength="6"
                               autocomplete="one-time-code"
                               inputmode="numeric"
                               pattern="[0-9]*"
                               required
                               autofocus />
                    </div>
                    <p class="twofa-hint">
                        <Icon Name="clock" Size="14" />
                        验证码每 30 秒刷新一次
                    </p>
                    <button type="submit" class="twofa-submit-btn">
                        绑定并登录
                    </button>
                </form>
            </div>
        }

        @* 已绑定用户：显示验证码输入框 *@
        @if (_hasSecret)
        {
            <form method="post" action="/auth/2fa-verify" class="twofa-form">
                <input type="hidden" name="__RequestVerificationToken" value="@requestToken" />
                <input type="hidden" name="TwoFactorToken" value="@_twoFactorToken" />
                <div class="twofa-input-group">
                    <input type="text"
                           name="Code"
                           class="twofa-code-input"
                           placeholder="输入 6 位验证码"
                           maxlength="6"
                           autocomplete="one-time-code"
                           inputmode="numeric"
                           pattern="[0-9]*"
                           required
                           autofocus />
                </div>
                <p class="twofa-hint">
                    <Icon Name="clock" Size="14" />
                    验证码每 30 秒刷新一次
                </p>
                <button type="submit" class="twofa-submit-btn">
                    验证
                </button>
            </form>
        }

        <a href="/login" class="twofa-back">
            <Icon Name="arrow-left" Size="16" />
            返回登录
        </a>
    </div>
</div>

@code {
    /// <summary>从查询参数获取错误消息</summary>
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorParam { get; set; }

    /// <summary>从查询参数获取 setup 就绪标志（M-4 修复后由 /auth/2fa-setup 重定向携带）</summary>
    [SupplyParameterFromQuery(Name = "setup")]
    private string? SetupFlag { get; set; }

    /// <summary>从 Cookie 读取的二次验证临时令牌</summary>
    private string _twoFactorToken = string.Empty;

    /// <summary>用户是否已绑定 TOTP</summary>
    private bool _hasSecret;

    /// <summary>二维码是否已加载</summary>
    private bool _setupLoaded;

    /// <summary>二维码 Base64 图片</summary>
    private string _qrCodeBase64 = string.Empty;

    /// <summary>TOTP 密钥</summary>
    private string _secret = string.Empty;

    /// <summary>错误消息</summary>
    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;

        // 从 Cookie 读取 2FA 临时令牌（HttpOnly，仅服务端可读）
        _twoFactorToken = httpContext?.Request.Cookies["2fa_token"] ?? string.Empty;

        if (string.IsNullOrEmpty(_twoFactorToken))
        {
            httpContext?.Response.Redirect("/login");
            return;
        }

        // 从 Cookie 判断用户是否已绑定 TOTP（仅布尔标志，非敏感数据）
        var hasSecretCookie = httpContext?.Request.Cookies["2fa_has_secret"];
        _hasSecret = hasSecretCookie == "1";

        // M-4 修复：TOTP 密钥与二维码不再通过 Cookie 传输，改由服务端 IDistributedCache 提供
        // 当查询参数 setup=ready 时，从缓存读取并由服务端渲染到页面，避免 XSS 窃取
        if (SetupFlag == "ready" && !_hasSecret)
        {
            var cacheKey = $"2fa:setup:{_twoFactorToken}";
            var payload = await DistributedCache.GetStringAsync(cacheKey);
            if (!string.IsNullOrEmpty(payload))
            {
                try
                {
                    var setupData = JsonSerializer.Deserialize<TwoFactorSetupResult>(payload);
                    if (setupData is not null)
                    {
                        _secret = setupData.Secret;
                        _qrCodeBase64 = setupData.QrCodeBase64;
                        _setupLoaded = true;
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "解析 2FA setup 缓存数据失败");
                }
            }
        }

        // 处理错误消息
        _errorMessage = ErrorParam switch
        {
            "invalid" => "验证码错误，请重试",
            "expired" => "临时令牌已过期，请重新登录",
            "setup-failed" => "获取绑定信息失败，请重试",
            _ => string.Empty
        };
    }
}
