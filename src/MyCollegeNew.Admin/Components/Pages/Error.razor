@* 错误页 *@
@page "/Error"

<PageTitle>错误 - 管理员端</PageTitle>

<div class="empty-state">
    <div class="empty-state__icon">
        <Icon Name="alert-triangle" Size="48" />
    </div>
    <h2 class="empty-state__title">发生了错误</h2>
    <p class="empty-state__description">处理请求时出现了意外错误，请稍后重试</p>
    <a href="/" class="ui-btn ui-btn--primary" style="margin-top:var(--space-4)">返回首页</a>
</div>
