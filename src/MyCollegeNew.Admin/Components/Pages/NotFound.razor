@page "/not-found"

<PageTitle>404 - 页面未找到</PageTitle>

<div class="empty-state">
    <div class="empty-state__icon">
        <Icon Name="file-question" Size="48" />
    </div>
    <h2 class="empty-state__title">页面未找到</h2>
    <p class="empty-state__description">请求的页面不存在或已被移除</p>
    <a href="/" class="ui-btn ui-btn--primary" style="margin-top:var(--space-4)">返回首页</a>
</div>
